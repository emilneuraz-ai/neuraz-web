---
interface Props { phone?: boolean; responsive?: boolean; label: string; theme?: 'light' | 'dark'; capturedStatus?: boolean; }
const { phone=false, responsive=false, label, theme='light', capturedStatus=false }=Astro.props;
---
<div class:list={['device-frame',{phone,responsive,'captured-status':capturedStatus}]} data-device-frame data-theme={theme}>
  <div class="browser-chrome" aria-hidden="true"><span class="window-dots"><i></i><i></i><i></i></span><span class="address-bar">{label}</span><span class="browser-menu">···</span></div>
  <div class="phone-status" aria-hidden="true"><b>9:41</b><span class="dynamic-island"></span><span>▮▮▮ &nbsp;▰</span></div>
  <div class="device-content"><slot /></div>
  <div class="home-indicator" aria-hidden="true"></div>
</div>
<style>
.device-frame{--frame-border:#c9c9ce;--frame-bg:#fff;--chrome-bg:#f1f1f3;--chrome-border:#dcdce0;--chrome-text:#69696e;--chrome-dots:#c3c3c9;--address-bg:#fff8;--address-border:#ddd;position:relative;width:100%;margin-inline:auto;border:1px solid var(--frame-border);border-radius:12px;overflow:hidden;background:var(--frame-bg);box-shadow:0 28px 65px -16px #0004,0 5px 15px #0001}
.device-frame[data-theme="dark"]{--frame-border:#444;--frame-bg:#111;--chrome-bg:#222;--chrome-border:#3b3b3b;--chrome-text:#ddd;--chrome-dots:#666;--address-bg:#151515;--address-border:#404040}
.phone.captured-status{background:var(--frame-bg)}.phone.captured-status .phone-status{display:none}.phone.captured-status .device-content{padding-bottom:0}.phone.captured-status .home-indicator{background:#fff}
.browser-chrome{height:36px;display:flex;align-items:center;gap:20px;padding:0 13px;background:var(--chrome-bg);border-bottom:1px solid var(--chrome-border);color:var(--chrome-text);font:11px/1 system-ui,sans-serif}.window-dots{display:flex;gap:5px}.window-dots i{width:7px;height:7px;border-radius:50%;background:var(--chrome-dots)}.address-bar{flex:1;max-width:60%;margin:auto;text-align:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;background:var(--address-bg);border:1px solid var(--address-border);border-radius:5px;padding:5px 18px}.browser-menu{font-size:20px}.phone-status,.home-indicator{display:none}.device-content{overflow:hidden}
.device-content :global(work-demo-frame){border:0!important;border-radius:0!important;box-shadow:none!important;margin:0;width:100%!important}.device-content :global(.ac-phone){border:0!important;border-radius:0!important;box-shadow:none!important;width:100%}.device-content :global(.ac-halo){display:none}.device-content :global(.ac-status){display:none}
.phone{background:#fff;width:min(100%,340px);border:8px solid #161618;border-radius:42px;box-shadow:0 0 0 1px #777,0 28px 65px -14px #0006,0 8px 16px #0002}.phone .browser-chrome{display:none}.phone .phone-status{height:36px;padding:9px 15px 0;display:flex;align-items:center;justify-content:space-between;font:10px/1 system-ui;color:#111;background:#fff;position:relative}.dynamic-island{position:absolute;left:50%;top:7px;transform:translateX(-50%);width:88px;height:23px;border-radius:20px;background:#111}.phone .home-indicator{display:block;position:absolute;bottom:7px;left:34%;width:32%;height:4px;background:#111;border-radius:4px;box-shadow:0 0 1px #fff8;pointer-events:none}.phone .device-content{padding-bottom:12px}
@media(max-width:767px){.responsive{background:#fff;width:min(100%,340px);border:8px solid #161618;border-radius:42px;box-shadow:0 0 0 1px #777,0 28px 65px -14px #0006,0 8px 16px #0002}.responsive .browser-chrome{display:none}.responsive .phone-status{height:36px;padding:9px 15px 0;display:flex;align-items:center;justify-content:space-between;font:10px/1 system-ui;color:#111;background:#fff;position:relative}.responsive .home-indicator{display:block;position:absolute;bottom:7px;left:34%;width:32%;height:4px;background:#111;border-radius:4px;pointer-events:none}.responsive .device-content{padding-bottom:12px}}
@media(max-width:767px){.device-frame{box-shadow:0 18px 28px -8px #0003,0 3px 8px #0001}.phone,.responsive{box-shadow:0 0 0 1px #777,0 18px 30px -10px #0004,0 4px 10px #0002}}
</style>
