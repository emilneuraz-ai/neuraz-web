---
import SectionAtmosphere from './SectionAtmosphere.astro';
---

<section class="hero ambient-section" aria-labelledby="hero-title">
  <SectionAtmosphere variant="hero" />
  <div class="hero-inner">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="hero-eyebrow"><span aria-hidden="true"></span> Tecnología con propósito</p>
        <h1 id="hero-title">
          <span class="hero-outline">Diseñamos</span>
          <span>sistemas</span>
          <span>inteligentes</span>
        </h1>
        <p class="hero-description">
          Conectamos tus herramientas y automatizamos lo repetitivo.
          Más tiempo para lo que hacés mejor.
        </p>
        <a href="#servicios" class="hero-link">
          <span class="hero-link-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 4v15m-6-6 6 6 6-6" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </span>
          Ver servicios
        </a>
      </div>
      <div class="hero-visual">
        <div class="hero-logo-slot" data-hero-logo-slot><img src="/images/isotipo.svg" alt="Neuraz" width="440" height="440" /></div>
      </div>
    </div>
    <div class="hero-footnote">
      <p>Herramientas a medida. <span>Para negocios reales.</span></p>
      <a href="#nosotros">Así trabajamos <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .hero {
    --hero-gutter: clamp(2rem, 6vw, 7.5rem);
    padding: 6.5rem var(--hero-gutter) 0;
    background: #fafafa;
    color: #111;
    display: flex;
  }
  .hero { isolation: auto; }
  .hero :global(.section-atmosphere) { z-index: 0; }
  .hero-logo-slot { width: 100%; aspect-ratio: 1; }
  .hero-logo-slot img { width: 100%; height: 100%; object-fit: contain; padding: 12%; }
  .hero-logo-slot[data-shared-ready="true"] img { visibility: hidden; }
  .hero-footnote { position: relative; z-index: 30; }
  .hero-inner {
    width: 100%;
    max-width: 1648px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: center;
    flex: 1;
    padding-bottom: 1.5rem;
  }
  .hero-copy {
    grid-column: 1 / 7;
    grid-row: 1;
    position: relative;
    z-index: 200;
    pointer-events: none;
  }
  .hero-copy a { pointer-events: auto; }
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 2.25rem;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #666;
  }
  .hero-eyebrow > span {
    width: 6px;
    height: 6px;
    background: #e63946;
    flex: none;
  }
  h1 {
    margin: 0;
    font-size: clamp(4.5rem, 8.1vw, 8rem);
    font-weight: 600;
    line-height: 0.99;
    letter-spacing: -0.065em;
  }
  h1 > span { display: block; }
  @supports (-webkit-text-stroke: 1px #111) {
    .hero-outline {
      color: #fafafa;
      -webkit-text-fill-color: #fafafa;
      -webkit-text-stroke: 2px #111;
      paint-order: stroke fill;
    }
  }
  .hero-description {
    max-width: 350px;
    margin: 1.75rem 0 1.5rem;
    color: #666;
    font-size: 14px;
    line-height: 1.7;
    text-wrap: pretty;
  }
  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-size: 13px;
    font-weight: 500;
  }
  .hero-link-icon {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #111;
    color: #fafafa;
    transition: background 180ms;
  }
  .hero-link-icon svg { width: 20px; height: 20px; transition: transform 180ms; }
  .hero-link:hover .hero-link-icon { background: #e63946; }
  .hero-link:hover svg { transform: translateY(2px); }
  .hero a:focus-visible { outline: 2px solid #e63946; outline-offset: 6px; }
  .hero-visual {
    grid-column: 6 / -1;
    grid-row: 1;
    min-width: 0;
    width: 100%;
    margin-left: 0;
  }
  .hero-footnote {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid #dedede;
    padding: 1.25rem 0;
    font-size: 11px;
    line-height: 1.6;
  }
  .hero-footnote p { margin: 0; }
  .hero-footnote p span { color: #707070; }
  .hero-footnote a { white-space: nowrap; }
  .hero-footnote a span { display: inline-block; margin-left: 1.2rem; }
  @media (min-width: 1024px) {
    .hero-grid { min-height: clamp(600px, calc(100svh - 10rem), 880px); }
    .hero-visual {
      position: absolute;
      grid-column: auto;
      grid-row: auto;
      right: 0;
      top: 50%;
      width: 58.333%;
      transform: translateY(-50%);
    }
  }
  @media (max-width: 1023px) {
    .hero { padding-top: 6.5rem; }
    .hero-grid { grid-template-columns: minmax(0, 1fr); }
    .hero-copy { grid-column: 1; grid-row: 1; }
    .hero-visual { grid-column: 1; grid-row: 2; margin-top: -1rem; }
    .hero-eyebrow { font-size: 9px; margin-bottom: 2rem; }
    h1 { font-size: clamp(3rem, 7.7vw, 5rem); }
    .hero-description { font-size: 13px; max-width: 310px; }
  }
  @media (max-width: 767px) {
    .hero { --hero-gutter: clamp(1.75rem, 8vw, 2.5rem); padding: 6.5rem var(--hero-gutter) 0; }
    .hero-grid { grid-template-columns: minmax(0, 1fr); gap: 0; padding-bottom: 1.5rem; }
    .hero-copy { grid-column: 1; grid-row: 1; }
    .hero-eyebrow { display: none; }
    h1 { font-size: clamp(2.35rem, 15.4vw, 9rem); }
    @supports (font-size: 1cqi) {
      .hero-copy { container-type: inline-size; }
      h1 { font-size: 19.2cqi; }
    }
    .hero-outline { -webkit-text-stroke-width: 1.5px; }
    .hero-description { margin-top: 1.5rem; max-width: 330px; }
    .hero-link { gap: 0; text-decoration: underline; text-decoration-color: #aaa; text-underline-offset: 5px; }
    .hero-link-icon { display: none; }
    .hero-visual {
      grid-column: 1;
      grid-row: 2;
      width: calc((100% + 2 * var(--hero-gutter) - 24px) * .9);
      max-width: 648px;
      margin: -1rem 0 0;
      justify-self: center;
    }
    .hero-footnote { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-link-icon, .hero-link-icon svg { transition: none; }
    .hero-link:hover svg { transform: none; }
  }
  @media (forced-colors: active) {
    .hero-outline { color: CanvasText; -webkit-text-fill-color: CanvasText; -webkit-text-stroke-width: 0; }
  }
</style>
