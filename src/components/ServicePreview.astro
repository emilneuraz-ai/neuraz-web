---
import ServiceIllustration from './ServiceIllustration.astro';
import type { Service } from '../data/services';
import { serviceVisual } from '../data/services';
import { serviceDetails } from '../data/serviceDetails';
interface Props { service: Service; index: number; inline?: boolean; }
const { service, index, inline = false } = Astro.props;
const labels = ['Automatización', 'Atención automática', 'Fidelización', 'Experiencias de marca', 'Contenido con IA', 'Agentes', 'Documentación'];
---
<article class:list={['service-preview', inline ? 'preview-inline' : 'preview-floating']} data-service-preview={inline ? undefined : service.id} data-mobile-service-preview={inline ? service.id : undefined} style={`--service-accent: ${serviceVisual(index).color}`} aria-label={`Vista rápida: ${service.name}`} hidden={!inline}>
  <header class="preview-header"><span class="preview-eyebrow"><i aria-hidden="true"></i>Así funciona</span><span class="preview-index">0{index + 1} / 07</span></header>
  <h3>{labels[index]}</h3>
  <p class="preview-intro">{serviceDetails[service.slug].intro}</p>
  <ServiceIllustration slug={service.slug} steps={serviceDetails[service.slug].flow} compact />
  <a class="preview-expand" href={`/servicios/${service.slug}`} data-service-modal-link aria-label={`Ampliar ${service.name}`}><span>Explorar servicio</span><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 4H4v5m11-5h5v5M9 20H4v-5m11 5h5v-5" /></svg></a>
</article>
<style>
  .service-preview { padding: 20px 22px 0; border: 1px solid color-mix(in srgb, var(--service-accent) 25%, #fff); border-radius: 20px; background: color-mix(in srgb, var(--service-accent) 3%, #fffffff5); box-shadow: 0 16px 48px #1a1a1a18, 0 2px 6px #1a1a1a06; backdrop-filter: blur(18px); pointer-events: auto; }
  .preview-floating { position: absolute; bottom: 4%; right: 5%; width: min(340px, 86%); animation: preview-enter 400ms cubic-bezier(.2,.75,.2,1) both; }
  .service-preview[hidden], .preview-inline { display: none; }
  .preview-header { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 11px; }
  .preview-eyebrow { display: flex; align-items: center; gap: 7px; color: #626262; font-size: 9px; letter-spacing: .12em; text-transform: uppercase; }
  .preview-eyebrow i { width: 5px; height: 5px; background: var(--service-accent); border-radius: 50%; }
  .preview-index { color: #777; font-size: 9px; font-variant-numeric: tabular-nums; }
  h3 { font-size: 20px; font-weight: 500; line-height: 1.1; letter-spacing: -.035em; margin: 0 0 9px; }
  .preview-intro { font-size: 12px; line-height: 1.5; color: #666; margin: 0 0 6px; }
  .preview-expand { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 48px; margin-top: 14px; border-top: 1px solid #00000012; color: #252525; font-size: 11px; font-weight: 500; text-decoration: none; }
  .preview-expand:hover { color: color-mix(in srgb, var(--service-accent) 65%, #111); }
  .preview-expand:focus-visible { outline: 2px solid #222; outline-offset: 3px; border-radius: 4px; }
  @keyframes preview-enter { from { opacity: 0; transform: translateY(10px) scale(.97); } to { opacity: 1; transform: none; } }
  @media (max-width: 1023px) {
    .preview-floating { display: none; }
    .preview-inline { display: block; position: relative; width: 100%; padding: 13px 16px 0; border-radius: 16px; box-shadow: 0 8px 24px #1a1a1a0a; }
    .preview-header { margin-bottom: 0; }
    h3, .preview-intro { display: none; }
    .preview-expand { min-height: 44px; margin-top: 8px; }
  }
  @media (prefers-reduced-motion: reduce) { .preview-floating { animation: none; } }
</style>
