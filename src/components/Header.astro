---
// src/components/Header.astro - Simple mobile menu
import NavbarBrand from './NavbarBrand.astro';
---

<header class="site-header">
  <div class="header-inner">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <NavbarBrand />

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-8">
        <a href="#servicios" class="text-[11px] font-medium tracking-[0.15em] text-black/60 hover:text-black transition-colors uppercase">Servicios</a>
        <a href="#trabajos" class="text-[11px] font-medium tracking-[0.15em] text-black/60 hover:text-black transition-colors uppercase">Trabajos</a>
        <a href="#equipo" class="text-[11px] font-medium tracking-[0.15em] text-black/60 hover:text-black transition-colors uppercase">El equipo</a>
        <a href="#contacto" class="text-[11px] font-medium tracking-[0.15em] text-black/60 hover:text-black transition-colors uppercase">Contacto</a>
      </nav>

      <!-- Mobile menu button -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="md:hidden p-2"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span id="menu-icon" class="organic-menu-icon" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none">
            <path d="M4.5 8.7c2.7-3.2 5.8 2.3 8.8-.2s4.7-3.2 7.1-.5 4.5-.1 7.1-1.2" />
            <path d="M5 15.8c2.3-2.5 4.9 2.1 7.4.1s4.7-2.8 7-.3 4.5.2 7.5-1" />
            <path d="M4.7 23.1c2.8-2.8 5.1 2 8 .1s4.5-3 7-.4 4.7.2 7.7-1.2" />
          </svg>
        </span>
        <span id="close-icon" class="organic-menu-icon hidden" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none">
            <path d="M7 6.5c2.8 3.9 5.5 5.5 9 9.5s5.9 5.3 9 9.5" />
            <path d="M25 6.5c-3 3.5-5.2 5.9-9 9.5s-5.7 5.8-9 9.5" />
          </svg>
        </span>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="hidden md:hidden bg-[#fafafa] border-t border-black/10">
      <nav class="flex flex-col py-6">
        <a href="#servicios" class="py-3 text-lg font-medium text-black/60 hover:text-black transition-colors mobile-link">Servicios</a>
        <a href="#trabajos" class="py-3 text-lg font-medium text-black/60 hover:text-black transition-colors mobile-link">Trabajos</a>
        <a href="#equipo" class="py-3 text-lg font-medium text-black/60 hover:text-black transition-colors mobile-link">El equipo</a>
        <a href="#contacto" class="py-3 text-lg font-medium text-black/60 hover:text-black transition-colors mobile-link">Contacto</a>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 300;
    isolation: isolate;
    background-color: var(--color-bg, #fafafa);

  }
  .site-header :global(.navbar-brand__isotipo) { display: none; }
  .site-header :global(.navbar-brand__link) { gap: 0; }
  nav a { position: relative; }
  nav a[aria-current="location"] { color: #111; }
  nav a[aria-current="location"]::after { content: ''; position: absolute; left: 0; right: 0; bottom: -8px; height: 2px; background: currentColor; }
  #mobile-menu nav a[aria-current="location"]::after { left: auto; right: 0; bottom: 50%; width: 6px; height: 6px; border-radius: 50%; }
  #mobile-menu-btn { place-items: center; width: 44px; height: 44px; padding: 0; }
  .organic-menu-icon { display: block; width: 30px; height: 30px; }
  .organic-menu-icon.hidden { display: none; }
  .organic-menu-icon svg { display: block; width: 100%; height: 100%; }
  .organic-menu-icon path { stroke: currentColor; stroke-width: 2.25; stroke-linecap: round; stroke-linejoin: round; }
  #mobile-menu {
    background-color: var(--color-bg, #fafafa);
    max-height: calc(100dvh - 5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .header-inner {
    width: 100%;
    max-width: calc(1648px + 2 * clamp(2rem, 6vw, 7.5rem));
    margin-inline: auto;
    padding-inline: clamp(2rem, 6vw, 7.5rem);
  }
  @media (max-width: 767px) {
    .site-header[data-projects-active="true"], .site-header[data-hidden="true"] { visibility:hidden; pointer-events:none; transform:translateY(-100%); }
    #mobile-menu-btn { display: grid; }
    .header-inner { padding-inline: clamp(1.75rem, 8vw, 2.5rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header { transition: none; }
  }
</style>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');
  const mobileLinks = document.querySelectorAll('.mobile-link');
  const siteHeader = document.querySelector<HTMLElement>('.site-header');
  const desktopNavigation = window.matchMedia('(min-width: 768px)');
  let lastScrollY = Math.max(0, scrollY);
  let directionOrigin = lastScrollY;
  let scrollDirection = 0;
  let scrollHidden = false;
  function showHeader() {
    scrollHidden = false;
    lastScrollY = Math.max(0, scrollY);
    directionOrigin = lastScrollY;
    scrollDirection = 0;
    siteHeader?.removeAttribute('data-hidden');
    if (siteHeader && siteHeader.dataset.projectsActive !== 'true') siteHeader.inert = false;
  }

  function setMenuOpen(open: boolean) {
    if (open) showHeader();
    mobileMenu?.classList.toggle('hidden', !open);
    menuIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    mobileMenuBtn?.setAttribute('aria-expanded', String(open));
    mobileMenuBtn?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  }

  mobileMenuBtn?.addEventListener('click', () => {
    setMenuOpen(mobileMenuBtn.getAttribute('aria-expanded') !== 'true');
  });

  mobileLinks.forEach(link => {
    link.addEventListener('click', () => setMenuOpen(false));
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && mobileMenuBtn?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false);
      mobileMenuBtn.focus();
    }
  });
  desktopNavigation.addEventListener('change', event => {
    if (event.matches) setMenuOpen(false);
  });
  siteHeader?.addEventListener('focusin', showHeader);
  window.addEventListener('pageshow', () => {
    showHeader();
  });

  // Track the section under the fixed navigation, including the entire pinned story.
  const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.site-header nav a[href^="#"]'));
  const sectionIds = [...new Set(sectionLinks.map(link => link.hash.slice(1)))];
  const sections = sectionIds.map(id => document.getElementById(id)).filter((section): section is HTMLElement => !!section);
  let navFrame = 0;
  const updateActiveSection = () => {
    navFrame = 0;
    const position = Math.max(0, Math.min(scrollY, document.documentElement.scrollHeight - innerHeight));
    const delta = position - lastScrollY;
    const direction = Math.sign(delta);
    if (direction && direction !== scrollDirection) { directionOrigin = lastScrollY; scrollDirection = direction; }
    if (direction && Math.abs(position - directionOrigin) >= 12) scrollHidden = direction > 0;
    if (position <= 80 || desktopNavigation.matches || mobileMenuBtn?.getAttribute('aria-expanded') === 'true') scrollHidden = false;
    lastScrollY = position;
    const projectsBounds = document.getElementById('trabajos')?.getBoundingClientRect();
    const projectsActive = !desktopNavigation.matches && !!projectsBounds && projectsBounds.top <= 1 && projectsBounds.bottom >= innerHeight - 1;
    if (siteHeader) {
      siteHeader.dataset.projectsActive = String(projectsActive);
      const hidden = !desktopNavigation.matches && scrollHidden;
      if (hidden) siteHeader.dataset.hidden = 'true';
      else siteHeader.removeAttribute('data-hidden');
      siteHeader.inert = projectsActive || hidden;
    }
    if (projectsActive && mobileMenuBtn?.getAttribute('aria-expanded') === 'true') setMenuOpen(false);
    const marker = 100;
    let active = '';
    for (const section of sections) {
      const rect = section.getBoundingClientRect();
      if (rect.top <= marker && rect.bottom > 80) active = section.id;
    }
    if (innerHeight + scrollY >= document.documentElement.scrollHeight - 3) active = 'contacto';
    sectionLinks.forEach(link => {
      if (link.hash === `#${active}`) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };
  const queueActiveSection = () => { if (!navFrame) navFrame = requestAnimationFrame(updateActiveSection); };
  window.addEventListener('scroll', queueActiveSection, { passive: true });
  window.addEventListener('resize', queueActiveSection, { passive: true });
  window.addEventListener('pageshow', queueActiveSection);
  updateActiveSection();
</script>
