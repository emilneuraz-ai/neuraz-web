---
import DemoFrame from './DemoFrame.astro';
import Icon from './AclimatarIcon.astro';
interface Props { view: string; }
const { view } = Astro.props;
const base='/images/works/aclimatar-tanzania/';
const tabs=['Summary','Tips','Indicators','ENSO'];
const routes=[{icon:'rain',title:'Seasonal forecast',text:'Precipitation probabilities and key variable forecasts.'},{icon:'leaf',title:'Tips and management',text:'Tactical guidance for each crop stage.'},{icon:'sun',title:'Long-term climate risk',text:'Future crop risks and recommended adaptation.'}];
---
<DemoFrame mobile height={700} label={`Aclimatar Tanzania · ${view}`}>
<div class="ac-presentation">
  <div class="ac-halo" aria-hidden="true"></div>
  <aclimatar-demo class="ac-phone" data-ac-view={view}>
    <div class="ac-status" aria-hidden="true"><b>9:41</b><span>▥ ◔ ▰</span></div>
    <div class="ac-topbar"><img src={`${base}logo.svg`} alt="ACLIMATAR+ Tanzania" width="198" height="21"/><span class="ac-settings" aria-hidden="true">☷</span></div>
    {view === 'inicio' ? <>
      <div class="ac-hero"><h5>Your integrated climate data center for coffee farming</h5><p>All the hard-to-get-hands on climate data, including seasonal forecasts and long term projections.</p><div class="ac-hero-progress" aria-hidden="true"><i></i><i></i><i></i><i></i></div></div>
      <div class="ac-location"><h5>Choose your location of interest</h5><details><summary><Icon name="pin"/><span><small>MY LOCATIONS</small><b>View and edit saved locations</b></span><span class="ac-open">⌄</span></summary><div class="ac-saved"><b>Dodoma Farm</b><span>Tanzania · Dodoma station</span></div></details><button type="button" class="ac-primary" data-ac-location aria-expanded="false">Add new location</button><div class="ac-location-note" hidden>Choose a location to explore climate information.</div></div>
    </> : <>
      <div class="ac-screen-header"><span aria-hidden="true">‹</span><h5>{view==='dashboard'?'Dashboard':'Seasonal forecast'}</h5><Icon name="calendar"/><span aria-hidden="true">⋮</span></div>
      {view==='dashboard' ? <>
        <div class="ac-dashboard-grid">
          <section class="ac-panel ac-weather"><div class="ac-weather-head"><div><h6>Moshi, TZ</h6><small>05 Mar, 05:19 PM</small></div><span><Icon name="rain"/><b>23°C</b></span></div><div class="ac-weather-status"><span>Heavy rain</span><b>23°C</b></div><p>Feels like 23°C · Cloudy<br/>Light breeze.</p><div class="ac-metrics">{[{icon:'wind',name:'Wind',value:'2.7 m/s N'},{icon:'gauge',name:'Pressure',value:'1011 hPa'},{icon:'drop',name:'Humidity',value:'74%'},{icon:'eye',name:'Visibility',value:'10.0 km'}].map(metric=><div><Icon name={metric.icon}/><span>{metric.name}<b>{metric.value}</b></span></div>)}</div><div class="ac-soft-row"><span>Dew point 18°C</span><span>UV: 0</span></div></section>
          <section class="ac-panel ac-place"><h6><Icon name="pin"/> Location</h6><dl><dt>Name:</dt><dd>Dodoma Farm</dd><dt>Country:</dt><dd>Tanzania</dd><dt>Latitude:</dt><dd>-0.21149</dd><dt>Longitude:</dt><dd>37.34580</dd><dt>Station ref.:</dt><dd>Dodoma · tz_00005</dd></dl></section>
          <section class="ac-panel ac-information"><h6><Icon name="info"/> Climate information</h6><p>Climate data and recommended actions for the selected station.</p><details><summary>Show more</summary><p>Current weather, location, forecasts and management guidance in one viewer.</p></details></section>
        </div>
        <div class="ac-routes">{routes.map(route=><div class="ac-route"><span class="ac-route-icon"><Icon name={route.icon}/></span><div><strong>{route.title}</strong><small>{route.text}</small></div><Icon name="arrow"/></div>)}</div>
      </> : <>
        <div class="ac-tabs" role="group" aria-label="Vistas del pronóstico de ejemplo">{tabs.map((tab,i)=><button type="button" data-ac-tab={tab} aria-pressed={i===0?'true':'false'}>{tab}</button>)}</div>
        <div class="ac-forecast-content">
          <div class="ac-forecast-grid" data-ac-panel="Summary">
            <section class="ac-panel"><h6>Precipitation probability</h6><small>February · March · April 2026</small><div class="ac-donut"><Icon name="rain"/><b>66%</b></div><ul class="ac-legend"><li><i></i>Above normal</li><li><i></i>Near normal</li><li><i></i>Below normal</li></ul><p class="ac-callout">In Arusha, precipitation is more likely to be above normal.</p></section>
            <section class="ac-panel"><h6><Icon name="info"/> What does it mean?</h6><p>There is a high probability that rainfall will be above normal between February and April.</p><ul class="ac-meaning"><li><Icon name="leaf"/>Possible wetter-than-average conditions.</li><li><Icon name="drop"/>Higher water availability for crops.</li><li><Icon name="warning"/>Plan pest management ahead.</li></ul></section>
          </div>
          <div class="ac-forecast-grid" data-ac-panel="Tips" hidden><section class="ac-panel ac-tip"><h6>Featured tactical tip</h6><strong>Light pruning · Feb - Mar</strong><p>Light pruning before the rains can improve airflow.</p><Icon name="leaf"/></section><section class="ac-panel ac-management"><h6>Suggested management</h6><p>Prioritize drainage, rust monitoring, and organic fertilization planning.</p><p class="ac-callout">Review the farm calendar before moving tasks between months.</p></section></div>
          <section class="ac-panel ac-indicators" data-ac-panel="Indicators" hidden><h6>Monthly indicators</h6><table><thead><tr><th scope="col">Indicator</th><th scope="col">Feb</th><th scope="col">Mar</th><th scope="col">Apr</th></tr></thead><tbody><tr><th scope="row">Precipitation (mm)</th><td>110</td><td>160</td><td>140</td></tr><tr><th scope="row">Solar radiation</th><td>20.5</td><td>19.2</td><td>17.8</td></tr><tr><th scope="row">Max. temperature</th><td>30.4</td><td>29.8</td><td>29.2</td></tr><tr><th scope="row">Min. temperature</th><td>17.1</td><td>17.0</td><td>16.6</td></tr></tbody></table></section>
          <div class="ac-enso" data-ac-panel="ENSO" hidden><section class="ac-panel"><h6>ENSO · La Nina</h6><div class="ac-enso-row"><b>FMA 2026</b><span>20%</span><span>30%</span><span>50%</span></div><div class="ac-enso-row"><b>MAM 2026</b><span>22%</span><span>33%</span><span>45%</span></div></section><section class="ac-panel"><h6>Quick read</h6><p>The signal favors more frequent rains and possible calendar adjustments.</p></section></div>
        </div>
      </>}
      <div class="ac-utility"><span><Icon name="pin"/> Dodoma</span><span>Editar</span><span>↓ Descargar</span><button type="button" data-ac-save aria-pressed="false">Guardar</button></div>
    </>}
  </aclimatar-demo>
  <span class="ac-prototype-label">PROTOTIPO DE INTERFAZ · DATOS DE EJEMPLO</span>
</div>
</DemoFrame>
<style>
  @font-face { font-family:'Aclimatar Sans'; src:url('/images/works/aclimatar-tanzania/source-sans-pro-latin-400-normal.woff2') format('woff2'); font-weight:400; font-display:swap; }
  @font-face { font-family:'Aclimatar Sans'; src:url('/images/works/aclimatar-tanzania/source-sans-pro-latin-700-normal.woff2') format('woff2'); font-weight:700; font-display:swap; }
  @font-face { font-family:'Aclimatar Serif'; src:url('/images/works/aclimatar-tanzania/source-serif-pro-latin-600-normal.woff2') format('woff2'); font-weight:600; font-display:swap; }
  .ac-presentation { position:relative; display:flex; align-items:center; flex-direction:column; }
  .ac-halo { position:absolute; inset:8% 0; background:radial-gradient(ellipse,#719d7940,transparent 68%); pointer-events:none; }
  .ac-phone { display:block; position:relative; width:360px; min-height:680px; max-width:100%; background:#fffefd; color:#14231f; font-family:'Aclimatar Sans',sans-serif; font-size:12px; line-height:1.4; border:1px solid #ead8c433; border-radius:24px; overflow:hidden; box-shadow:0 24px 60px #0002; }
  .ac-phone h5,.ac-phone h6,.ac-phone p { margin:0; }.ac-phone h5 { font-family:'Aclimatar Serif',serif; font-weight:600; }.ac-phone h6 { font-family:'Aclimatar Sans',sans-serif; font-weight:700; line-height:1.2; font-size:14px; }.ac-phone p { font-size:11px; line-height:1.45; }.ac-phone small { font-size:9px; }.ac-phone strong,.ac-phone b { font-weight:700; }
  .ac-status,.ac-topbar { display:flex; align-items:center; justify-content:space-between; background:#b96743; color:white; }.ac-status { padding:10px 24px 8px; font-size:12px; }.ac-status>span { letter-spacing:3px; }.ac-topbar { height:48px; padding:0 14px; border-top:1px solid #78392425; }.ac-topbar img { width:188px; height:20px; }.ac-settings { border:1px solid #ffffff50; width:29px; height:29px; display:grid; place-items:center; border-radius:50%; font-size:19px; }
  .ac-hero { background:linear-gradient(180deg,#b9674357,#b96743c7),url('/images/works/aclimatar-tanzania/hero-bg.png') center/cover; background-color:#b96743; padding:29px 26px 25px; color:#fff; }.ac-hero h5 { font-size:29px; line-height:1.08; max-width:290px; }.ac-hero p { font-size:13px; margin:20px 0 16px; }.ac-hero-progress { display:flex; gap:4px; }.ac-hero-progress i { width:24px; height:3px; background:#ffffff70; }.ac-hero-progress i:first-child { width:42px; background:white; }
  .ac-location { padding:20px 24px 26px; }.ac-location h5 { font-size:23px; line-height:1.1; margin-bottom:16px; color:#073f31; }.ac-location summary { display:flex; align-items:center; gap:9px; cursor:pointer; background:#fbfaf6; border:1px solid #ded8d0; padding:11px 9px; border-radius:6px; }.ac-location summary>span { display:grid; gap:3px; }.ac-location summary small { color:#777b73; font-size:8px; }.ac-location summary b { font-size:10px; }.ac-location .ac-open { margin-left:auto; }.ac-saved { padding:10px; border:1px solid #ded8d0; border-top:0; display:grid; gap:4px; font-size:10px; }.ac-primary { display:block; margin-top:12px; background:#073f31; color:white; padding:11px; width:100%; border-radius:5px; font-size:12px; font-weight:700; }.ac-location-note { font-size:10px; margin-top:10px; color:#073f31; }
  .ac-screen-header { display:flex; gap:13px; align-items:center; padding:13px 20px; border-bottom:1px solid #ded8d060; color:#235f4f; }.ac-screen-header h5 { font-family:'Aclimatar Sans',sans-serif; font-weight:700; font-size:16px; flex:1; }.ac-screen-header>span:first-child { font-size:26px; line-height:1; }.ac-screen-header>span:last-child { font-size:22px; line-height:1; }
  .ac-dashboard-grid { display:grid; grid-template-columns:1.05fr .95fr; gap:7px; padding:9px 10px 6px; }.ac-panel { background:#fff; border:1px solid #ded8d0; border-radius:7px; padding:10px; box-shadow:0 5px 16px #4f38250c; min-width:0; }.ac-panel h6 { margin-bottom:10px; }.ac-panel h6 :global(svg) { margin-right:3px; }.ac-panel p { margin:9px 0; }.ac-weather { grid-row:span 2; background:#f3faf4; border-color:#b8dbc7; }.ac-weather-head { display:flex; gap:4px; }.ac-weather-head>div { flex:1; }.ac-weather-head h6 { margin-bottom:4px; }.ac-weather-head>span { display:flex; align-items:center; font-size:22px; gap:2px; }.ac-weather-head>span :global(svg) { width:30px; height:30px; }.ac-weather-head>div small { font-size:8px; }.ac-weather-status { display:flex; gap:5px; margin:8px 0; }.ac-weather-status>* { padding:5px 7px; background:#dfe9e1; border-radius:4px; font-size:9px; }.ac-weather-status>span { background:#235f4f; color:white; }.ac-metrics { display:grid; grid-template-columns:1fr 1fr; border-block:1px solid #ded8d0; margin:9px 0; }.ac-metrics>div { display:flex; align-items:flex-start; gap:4px; padding:9px 2px; font-size:8px; }.ac-metrics>div:nth-child(odd) { border-right:1px solid #ded8d0; }.ac-metrics :global(svg) { width:20px; height:20px; }.ac-metrics b { display:block; font-size:8px; margin-top:8px; white-space:nowrap; }.ac-soft-row { display:flex; justify-content:space-between; gap:4px; padding:6px; background:#dfe9e1; border-radius:4px; font-size:8px; }.ac-place { background:#fbf8ff; border-color:#dfd5f2; }.ac-place dl { display:grid; grid-template-columns:auto 1fr; gap:6px 5px; margin:0; font-size:8px; }.ac-place dt { font-weight:700; }.ac-place dd { margin:0; }.ac-information h6 { color:#1f66d1; font-size:12px; }.ac-information summary { color:#1f66d1; text-decoration:underline; font-weight:700; font-size:10px; cursor:pointer; }.ac-information p { font-size:10px; }
  .ac-routes { display:grid; gap:6px; padding:4px 12px 10px; }.ac-route { display:flex; align-items:center; gap:9px; border:1px solid #ded8d0; border-radius:7px; padding:9px; }.ac-route>div { flex:1; }.ac-route strong { font-size:13px; display:block; }.ac-route small { display:block; font-size:9px; }.ac-route-icon { width:36px; height:36px; background:#eff1e9; display:grid; place-items:center; border-radius:50%; color:#235f4f; font-size:19px; flex:none; }
  .ac-tabs { display:grid; grid-template-columns:repeat(4,1fr); margin:0 11px 8px; padding:4px; border:1px solid #ded8d0; border-radius:7px; background:white; }.ac-tabs button { font-size:11px; padding:7px 2px; border-bottom:2px solid transparent; }.ac-tabs button[aria-pressed=true] { border-color:#073f31; font-weight:700; }.ac-forecast-content { padding:3px 11px 14px; min-height:320px; }.ac-forecast-grid { display:grid; grid-template-columns:1fr .9fr; gap:7px; }.ac-forecast-grid h6 { font-size:14px; }.ac-forecast-grid small { font-size:9px; }.ac-donut { width:104px; height:104px; position:relative; display:grid; place-items:center; margin:14px auto; border-radius:50%; background:conic-gradient(#006a50 0 66%,#d94a24 66% 83%,#91958f 83% 100%); }.ac-donut::after { content:''; position:absolute; inset:28px; border-radius:50%; background:white; }.ac-donut :global(svg) { position:relative; z-index:1; color:#073f31; width:30px; height:30px; }.ac-donut b { position:absolute; right:5px; bottom:27px; z-index:1; color:white; font-size:12px; }.ac-legend,.ac-meaning { display:grid; gap:7px; padding:0; margin:0; list-style:none; font-size:9px; }.ac-legend i { display:inline-block; width:8px; height:8px; border-radius:50%; background:#006a50; margin-right:5px; }.ac-legend li:nth-child(2) i { background:#d94a24; }.ac-legend li:nth-child(3) i { background:#91958f; }.ac-panel .ac-callout { padding:7px; border-radius:4px; background:#eff4ea; font-size:10px; margin-bottom:0; }.ac-meaning li { display:flex; align-items:flex-start; gap:6px; }.ac-meaning :global(svg) { width:17px; height:17px; }.ac-tip { background:#f4f7ef; }.ac-tip>strong { font-size:12px; }.ac-tip> :global(svg) { display:block; width:40px; height:40px; color:#235f4f; margin:18px auto; }.ac-management { background:#fff5eb; }.ac-indicators table { width:100%; border-collapse:collapse; font-size:10px; }.ac-indicators th,.ac-indicators td { text-align:left; padding:13px 4px; border-bottom:1px solid #ded8d0; }.ac-indicators tbody th { font-weight:400; }.ac-enso { display:grid; gap:10px; }.ac-enso-row { display:flex; gap:0; font-size:10px; margin:15px 0; }.ac-enso-row>b { width:70px; }.ac-enso-row>span { padding:7px 10px; background:#e9c1a5; }.ac-enso-row>span:nth-last-child(2) { background:#e5e9e1; }.ac-enso-row>span:last-child { background:#bcd9c6; }
  .ac-utility { display:flex; align-items:center; gap:10px; padding:12px; border-top:1px solid #ded8d0; background:#fbf8f4; font-size:9px; color:#073f31; }.ac-utility>span:first-child { margin-right:auto; }.ac-utility button { font-size:9px; font-weight:700; }.ac-prototype-label { position:relative; display:block; margin-top:13px; font-size:7px; letter-spacing:.13em; color:var(--work-muted); }
  button,summary { cursor:pointer; }button { font-family:inherit; }button:focus-visible,summary:focus-visible { outline:2px solid #b96743; outline-offset:3px; }[hidden] { display:none!important; }
  :global([data-active]) .ac-donut { animation:ac-chart-in 850ms ease both; }:global([data-active]) .ac-panel { animation:ac-panel-in 550ms ease both; }:global([data-active]) .ac-panel:nth-child(2) { animation-delay:90ms; }@keyframes ac-chart-in { from { transform:rotate(-60deg) scale(.8); opacity:0; } to { transform:none; opacity:1; } }@keyframes ac-panel-in { from { transform:translateY(10px); opacity:0; } to { transform:none; opacity:1; } }
  @media(prefers-reduced-motion:reduce) { .ac-panel,.ac-donut { animation:none!important; } }
  @media(max-width:767px) { .ac-phone { width:330px; min-height:680px; border-radius:18px; }.ac-hero { padding:23px; }.ac-hero h5 { font-size:26px; }.ac-hero p { font-size:12px; margin-top:16px; }.ac-location { padding:16px 20px 22px; }.ac-location h5 { font-size:21px; }.ac-weather-head>span { font-size:18px; }.ac-weather-head>span :global(svg) { width:24px; height:24px; }.ac-panel { padding:8px; }.ac-phone h6 { font-size:12px; }.ac-phone p { font-size:10px; }.ac-forecast-content { min-height:310px; } }
</style>
<script>
  class AclimatarDemo extends HTMLElement {
    private abort?: AbortController;
    connectedCallback(){
      if(this.abort)return;
      this.abort=new AbortController();
      this.addEventListener('click',event=>{
        const button=(event.target as Element).closest<HTMLButtonElement>('button');if(!button)return;
        if(button.dataset.acTab){const name=button.dataset.acTab;this.querySelectorAll('[data-ac-tab]').forEach(tab=>tab.setAttribute('aria-pressed',String(tab===button)));this.querySelectorAll<HTMLElement>('[data-ac-panel]').forEach(panel=>{panel.hidden=panel.dataset.acPanel!==name;});}
        if(button.hasAttribute('data-ac-save')){const saved=button.getAttribute('aria-pressed')!=='true';button.setAttribute('aria-pressed',String(saved));button.textContent=saved?'Guardado ✓':'Guardar';}
        if(button.hasAttribute('data-ac-location')){const note=this.querySelector<HTMLElement>('.ac-location-note')!;note.hidden=!note.hidden;button.setAttribute('aria-expanded',String(!note.hidden));}
      },{signal:this.abort.signal});
    }
    disconnectedCallback(){this.abort?.abort();this.abort=undefined;}
  }
  if(!customElements.get('aclimatar-demo'))customElements.define('aclimatar-demo',AclimatarDemo);
</script>
