---
/** A reusable fluid surface, with the original GLB and poster as fallbacks. */
interface Props {
  class?: string;
  id?: string;
  label?: string;
  modelSrc?: string;
  posterSrc?: string;
  finish?: 'black' | 'mercury' | 'porcelain';
  view?: 'front' | 'isometric';
  fluid?: boolean;
  fluidSrc?: string;
  fluidMetadataSrc?: string;
  interactive?: boolean;
  autoplay?: boolean;
  controls?: boolean;
  loading?: 'lazy' | 'eager';
  reducedMotion?: 'poster' | 'static';
  aspectRatio?: number;
  exposure?: number;
  environmentIntensity?: number;
  maxDpr?: number;
  framing?: number;
}

const {
  class: className,
  id,
  label = 'Isotipo Neuraz tridimensional',
  modelSrc = '/models/neuraz-mercury.glb',
  posterSrc = '/images/neuraz-mercury-poster.png',
  finish = 'black',
  view = 'front',
  fluid = true,
  fluidSrc = '/models/neuraz-mercury-fluid.bin.gz',
  fluidMetadataSrc = '/models/neuraz-mercury-fluid.json',
  interactive = true,
  autoplay = true,
  controls = false,
  loading = 'lazy',
  reducedMotion = 'poster',
  aspectRatio = 1,
  exposure = finish === 'black' ? 1 : 1.1,
  environmentIntensity = finish === 'black' ? 0.5 : finish === 'porcelain' ? 0.8 : 1.3,
  maxDpr = 1.75,
  framing = 1.05,
} = Astro.props;
const helpId = `${id || `mercury-${crypto.randomUUID()}`}-help`;
const ratio = Number.isFinite(aspectRatio) && aspectRatio > 0 ? aspectRatio : 1;
---

<neuraz-mercury
  id={id}
  class:list={['mercury-logo', className]}
  style={`--mercury-aspect-ratio: ${ratio}`}
  data-model-src={modelSrc}
  data-finish={finish}
  data-view={view}
  data-fluid={String(fluid)}
  data-fluid-src={fluidSrc}
  data-fluid-metadata-src={fluidMetadataSrc}
  data-interactive={String(interactive)}
  data-autoplay={String(autoplay)}
  data-loading={loading}
  data-reduced-motion={reducedMotion}
  data-exposure={exposure}
  data-environment-intensity={environmentIntensity}
  data-max-dpr={maxDpr}
  data-framing={framing}
  data-ready="false"
  data-state="idle"
>
  <div
    class="mercury-stage"
    data-mercury-stage
    role={interactive ? 'group' : 'img'}
    aria-label={label}
    data-mercury-description={interactive ? helpId : undefined}
  >
    <img
      class="mercury-poster"
      src={posterSrc}
      alt=""
      aria-hidden="true"
      width="1080"
      height="1080"
      loading={loading}
      decoding="async"
      draggable="false"
    />
    <canvas class="mercury-canvas" data-mercury-canvas aria-hidden="true"></canvas>
    <div class="mercury-overlay" data-mercury-overlay>
      <slot name="overlay" />
    </div>
  </div>
  {interactive && (
    <span id={helpId} class="mercury-sr-only" hidden>
      Arrastrá o usá las flechas para girar el logo. Espacio pausa o reanuda el movimiento; R restablece la vista.
    </span>
  )}
  {controls && (
    <div class="mercury-controls" data-mercury-controls role="group" aria-label="Controles del logo" hidden>
      <button type="button" data-mercury-toggle aria-label="Pausar movimiento automático">
        <svg class="mercury-pause-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7 5v10M13 5v10" /></svg>
        <svg class="mercury-play-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m7 4 9 6-9 6V4Z" /></svg>
        <span data-mercury-toggle-label>Pausar</span>
      </button>
      {interactive && (
        <button type="button" data-mercury-reset aria-label="Restablecer vista del logo">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 9a6 6 0 1 1 1 4M4 4v5h5" /></svg>
          <span>Restablecer</span>
        </button>
      )}
    </div>
  )}
  <span class="mercury-sr-only" data-mercury-status role="status"></span>
</neuraz-mercury>

<script>
  // This small loader is shared by all instances; Three.js stays in a lazy chunk.
  class NeurazMercury extends HTMLElement {
    private lifetime?: AbortController;
    private request?: AbortController;
    private observer?: IntersectionObserver;
    private disposeView?: () => void;
    private motion?: MediaQueryList;
    private generation = 0;
    private pending = false;

    connectedCallback() {
      if (this.lifetime) return;
      this.lifetime = new AbortController();
      const { signal } = this.lifetime;
      this.motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      this.motion.addEventListener('change', this.restart, { signal });
      document.addEventListener('astro:before-swap', this.stop, { signal });
      document.addEventListener('astro:page-load', this.start, { signal });
      window.addEventListener('pagehide', this.stop, { signal });
      window.addEventListener('pageshow', this.onPageShow, { signal });
      queueMicrotask(this.start);
    }

    disconnectedCallback() {
      this.stop();
      this.lifetime?.abort();
      this.lifetime = undefined;
      this.motion = undefined;
    }

    private onPageShow = (event: PageTransitionEvent) => {
      if (event.persisted) this.start();
    };

    private restart = () => {
      this.stop();
      this.start();
    };

    private start = () => {
      if (!this.isConnected || !this.lifetime || this.pending || this.disposeView || this.observer) return;
      if (this.motion?.matches && this.dataset.reducedMotion !== 'static') {
        this.dataset.state = 'poster';
        return;
      }
      this.dataset.state = 'idle';
      if (this.dataset.loading === 'eager' || !('IntersectionObserver' in window)) {
        void this.load();
        return;
      }
      this.observer = new IntersectionObserver(entries => {
        if (!entries.some(entry => entry.isIntersecting)) return;
        this.observer?.disconnect();
        this.observer = undefined;
        void this.load();
      }, { rootMargin: '200px' });
      this.observer.observe(this);
    };

    private load = async () => {
      if (this.pending || this.disposeView || !this.isConnected) return;
      const generation = ++this.generation;
      this.pending = true;
      this.request = new AbortController();
      const { signal } = this.request;
      this.dataset.state = 'loading';
      try {
        const { initMercuryLogo } = await import('../scripts/mercury-logo');
        if (generation !== this.generation || !this.isConnected || signal.aborted) return;
        const dispose = await initMercuryLogo(this, { signal });
        if (generation !== this.generation || !this.isConnected || signal.aborted) dispose();
        else this.disposeView = dispose;
      } catch (error) {
        if (generation !== this.generation || signal.aborted) return;
        this.dataset.ready = 'false';
        this.dataset.state = 'error';
        const status = this.querySelector<HTMLElement>('[data-mercury-status]');
        if (status) status.textContent = 'Se muestra la imagen del logo.';
        this.dispatchEvent(new CustomEvent('mercury:error', { detail: { error } }));
      } finally {
        if (generation === this.generation) this.pending = false;
      }
    };

    private stop = () => {
      this.generation++;
      this.observer?.disconnect();
      this.observer = undefined;
      this.request?.abort();
      this.request = undefined;
      this.disposeView?.();
      this.disposeView = undefined;
      this.pending = false;
      this.dataset.ready = 'false';
      this.dataset.state = 'idle';
    };
  }

  if (!customElements.get('neuraz-mercury')) customElements.define('neuraz-mercury', NeurazMercury);
</script>

<style>
  .mercury-logo { display: flex; flex-direction: column; position: relative; width: 100%; aspect-ratio: var(--mercury-aspect-ratio, 1); isolation: isolate; color: var(--mercury-control-color, #303036); }
  .mercury-stage { position: relative; flex: 1; min-height: 0; width: 100%; outline: none; }
  .mercury-poster, .mercury-canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .mercury-poster { object-fit: contain; user-select: none; }
  .mercury-logo[data-finish='black'] .mercury-poster { filter: brightness(.16) saturate(0); }
  .mercury-canvas { opacity: 0; pointer-events: none; }
  .mercury-overlay { position: absolute; inset: 0; z-index: 2; visibility: hidden; pointer-events: none; }
  .mercury-logo[data-ready='true'] .mercury-overlay { visibility: visible; }
  .mercury-overlay :global([data-mercury-pin]) { position: absolute; pointer-events: auto; }
  .mercury-overlay :global([data-mercury-pin][data-visible='false']) { visibility: hidden; pointer-events: none; }
  .mercury-logo[data-ready='true'] .mercury-canvas { opacity: 1; }
  .mercury-logo[data-ready='true'] .mercury-poster { visibility: hidden; }
  .mercury-logo[data-ready='true'][data-interactive='true'] .mercury-stage { cursor: grab; touch-action: pan-y; }
  .mercury-logo[data-dragging='true'] .mercury-stage { cursor: grabbing; }
  .mercury-controls { display: flex; flex: none; align-self: center; margin-top: 8px; gap: 4px; white-space: nowrap; border: 1px solid var(--mercury-control-border, #16161b1a); padding: 3px; border-radius: 99px; background: var(--mercury-control-background, #ffffffd9); backdrop-filter: blur(10px); }
  .mercury-controls[hidden] { display: none; }
  .mercury-controls button { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-width: 44px; min-height: 44px; padding: 0 12px; border: 0; border-radius: 99px; background: transparent; color: inherit; font: inherit; font-size: 11px; line-height: 1.2; cursor: pointer; }
  .mercury-controls button:hover { background: #80808013; }
  .mercury-controls button:disabled { opacity: .5; cursor: default; }
  .mercury-controls svg { width: 16px; height: 16px; flex: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .mercury-play-icon { display: none; }
  .mercury-logo[data-playing='false'] .mercury-pause-icon { display: none; }
  .mercury-logo[data-playing='false'] .mercury-play-icon { display: block; }
  .mercury-stage:focus-visible { outline: none; }
  .mercury-logo[data-keyboard-focus='true'] .mercury-stage:focus::after { content: '← ↑ ↓ →  Girar · R  Restablecer'; position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%); padding: 7px 12px; border-radius: 99px; background: #171717; color: #fff; white-space: nowrap; font: 11px/1.4 system-ui, sans-serif; pointer-events: none; }
  .mercury-controls button:focus-visible { outline: 2px solid #777; outline-offset: 3px; }
  .mercury-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>
