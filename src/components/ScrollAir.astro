---
interface Props {
  seed: 'hero' | 'services';
  initiallyInactive?: boolean;
  direction?: 'vertical' | 'horizontal';
  color?: string;
}

const { seed, initiallyInactive = false, direction = 'vertical', color } = Astro.props;
---

<scroll-air class="scroll-air" data-air-seed={seed} data-air-direction={direction} data-service-color={color} data-active={initiallyInactive ? 'false' : 'true'} aria-hidden="true">
  <canvas></canvas>
</scroll-air>

<style>
  .scroll-air {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    opacity: 1;
    transition: opacity 420ms ease;
    mask-image: linear-gradient(180deg, transparent, #000 12%, #000 88%, transparent);
  }
  .scroll-air[data-active="false"] { opacity: 0; }
  .scroll-air[data-air-direction="horizontal"] { mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
  canvas { display: block; width: 100%; height: 100%; }
  @media (prefers-reduced-motion: reduce) { .scroll-air { display: none; transition: none; } }
</style>

<script>
  type Line = {
    x: number;
    y: number;
    length: number;
    speed: number;
    stretch: number;
    gap: number;
    split: number;
    opacity: number;
    dotRadius: number;
    dotSpacing: number;
    fan: number;
  };

  class ScrollAir extends HTMLElement {
    static observedAttributes = ['data-service-color'];
    private canvas?: HTMLCanvasElement;
    private context?: CanvasRenderingContext2D;
    private lines: Line[] = [];
    private width = 0;
    private height = 0;
    private momentum = 0;
    private lastScroll = 0;
    private visible = false;
    private frame = 0;
    private abort?: AbortController;
    private intersection?: IntersectionObserver;
    private resizeObserver?: ResizeObserver;
    private reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

    private get horizontal() { return this.dataset.airDirection === 'horizontal'; }

    attributeChangedCallback() {
      this.draw();
    }

    connectedCallback() {
      this.canvas = this.querySelector('canvas') ?? undefined;
      this.context = this.canvas?.getContext('2d') ?? undefined;
      if (!this.canvas || !this.context) return;
      this.abort = new AbortController();
      this.lastScroll = scrollY;
      this.resizeCanvas();
      this.intersection = new IntersectionObserver(entries => {
        this.visible = !!entries[0]?.isIntersecting;
        this.dataset.visible = String(this.visible && !document.hidden);
        this.lastScroll = scrollY;
        if (this.visible) this.draw();
      });
      this.intersection.observe(this);
      this.resizeObserver = new ResizeObserver(this.resizeCanvas);
      this.resizeObserver.observe(this);
      window.addEventListener('scroll', this.onScroll, { passive: true, signal: this.abort.signal });
      this.reducedMotion.addEventListener('change', this.onMotionChange, { signal: this.abort.signal });
      document.addEventListener('visibilitychange', this.onVisibilityChange, { signal: this.abort.signal });
    }

    disconnectedCallback() {
      this.abort?.abort();
      this.intersection?.disconnect();
      this.resizeObserver?.disconnect();
      cancelAnimationFrame(this.frame);
      this.frame = 0;
    }

    private randomizer() {
      let value = this.dataset.airSeed === 'services' ? 713 : 241;
      return () => ((value = (Math.imul(value, 1664525) + 1013904223) >>> 0) / 4294967296);
    }

    private resizeCanvas = () => {
      if (!this.canvas || !this.context) return;
      const bounds = this.getBoundingClientRect();
      // Work in cross-axis / travel-axis coordinates, then rotate the drawing.
      const width = Math.round(this.horizontal ? bounds.height : bounds.width);
      const height = Math.round(this.horizontal ? bounds.width : bounds.height);
      if (!width || !height || (width === this.width && height === this.height)) return;
      this.width = width;
      this.height = height;
      const scale = Math.min(devicePixelRatio || 1, 2);
      this.canvas.width = Math.round((this.horizontal ? height : width) * scale);
      this.canvas.height = Math.round((this.horizontal ? width : height) * scale);
      this.context.setTransform(scale, 0, 0, scale, 0, 0);
      const random = this.randomizer();
      const count = Math.min(22, Math.max(6, Math.round(width / 78)));
      this.lines = Array.from({ length: count }, () => ({
        x: random() * width,
        y: random() * height,
        length: 115 + random() * 150,
        speed: .12 + random() * .54,
        stretch: 45 + random() * 105,
        gap: .14 + random() * .16,
        split: .35 + random() * .18,
        opacity: .38 + random() * .1,
        dotRadius: 1.2 + random() * .35,
        dotSpacing: 6.5 + random() * 2,
        fan: 20 + random() * 18,
      }));
      this.draw();
    };

    private onScroll = () => {
      const delta = scrollY - this.lastScroll;
      this.lastScroll = scrollY;
      if (!this.visible || this.dataset.active === 'false' || this.reducedMotion.matches || document.hidden || !delta) return;
      const movement = Math.max(-320, Math.min(320, delta));
      for (const line of this.lines) {
        line.y -= movement * line.speed;
        if (line.y < -180) line.y = this.height + 20 + ((line.x * .73) % 120);
        else if (line.y > this.height + 180) line.y = -20 - ((line.x * .41) % 120);
      }
      this.momentum = Math.min(1, Math.max(this.momentum, Math.abs(movement) / 75));
      this.schedule();
    };

    private onMotionChange = () => {
      this.momentum = 0;
      if (this.reducedMotion.matches && this.context) this.context.clearRect(0, 0, this.canvas!.width, this.canvas!.height);
      else this.draw();
    };

    private onVisibilityChange = () => {
      this.lastScroll = scrollY;
      this.dataset.visible = String(this.visible && !document.hidden);
      if (!document.hidden) this.draw();
    };

    private schedule() {
      if (!this.frame) this.frame = requestAnimationFrame(this.animate);
    }

    private animate = () => {
      this.frame = 0;
      this.draw();
      this.momentum *= .7;
      if (this.momentum > .015 && this.visible && !document.hidden) this.schedule();
    };

    private draw() {
      const context = this.context;
      if (!context || !this.width || !this.height || this.reducedMotion.matches) return;
      context.clearRect(0, 0, this.horizontal ? this.height : this.width, this.horizontal ? this.width : this.height);
      context.save();
      if (this.horizontal) context.transform(0, 1, 1, 0, 0, 0);
      const hex = /^#[\da-f]{6}$/i.test(this.dataset.serviceColor || '') ? this.dataset.serviceColor! : '#f57c00';
      const rgb = [1, 3, 5].map(index => parseInt(hex.slice(index, index + 2), 16)).join(',');
      for (const [lineIndex, line] of this.lines.entries()) {
        const length = line.length + this.momentum * line.stretch;
        const lower = length * line.split;
        const gap = length * line.gap;
        const upper = length - lower - gap;
        context.fillStyle = `rgba(126, 135, 145, ${line.opacity})`;
        context.beginPath();
        for (const [top, height] of [[line.y - lower, lower], [line.y - length, upper]]) {
          for (let index = 0, y = top; y < top + height; index++, y += line.dotSpacing) {
            if (y < -line.dotRadius || y > this.height + line.dotRadius) continue;
            const rise = Math.max(0, Math.min(1, 1 - y / this.height));
            const spread = rise * rise;
            const hash = Math.sin((index + 1) * 12.9898 + line.x * .217) * 43758.5453;
            const offset = ((hash - Math.floor(hash)) * 2 - 1) * line.fan * spread;
            const dotX = line.x + offset;
            const dotY = y + Math.sin(index * 7.13 + line.x * .04) * 3 * spread;
            context.moveTo(dotX + line.dotRadius, dotY);
            context.arc(dotX, dotY, line.dotRadius, 0, Math.PI * 2);
          }
        }
        context.fill();
        if (this.dataset.airSeed === 'services' && lineIndex % 3 === 1) {
          const start = line.y - length;
          const x = line.x + 18;
          const amplitude = 5 + this.momentum * 5;
          const gradient = context.createLinearGradient(0, start, 0, line.y);
          gradient.addColorStop(0, `rgba(${rgb},0)`);
          gradient.addColorStop(.35, `rgba(${rgb},.15)`);
          gradient.addColorStop(1, `rgba(${rgb},.38)`);
          context.strokeStyle = gradient;
          context.lineWidth = 1.3;
          context.lineJoin = 'round';
          context.lineCap = 'round';
          context.beginPath();
          context.moveTo(x, start);
          const segments = Math.max(4, Math.round(length / 22));
          for (let step = 1; step <= segments; step++) {
            context.lineTo(x + (step === segments ? 0 : step % 2 ? amplitude : -amplitude), start + length * step / segments);
          }
          context.stroke();
        }
      }
      context.restore();
    }
  }

  if (!customElements.get('scroll-air')) customElements.define('scroll-air', ScrollAir);
</script>
