---
interface Props { slug: string; steps: string[]; compact?: boolean; }
const { slug, steps, compact = false } = Astro.props;
const kind = ({
  'automatizacion-de-flujos-de-negocio': 'workflow',
  'crm-con-atencion-automatica': 'conversation',
  'sistema-de-puntos-y-fidelizacion': 'rewards',
  'juegos-y-experiencias-de-marca': 'play',
  'generacion-automatica-de-contenido-con-ia': 'content',
  'agentes-de-ia': 'agent',
  'documentacion-inteligente': 'documents',
  'capacitaciones-en-ia-y-automatizacion': 'learning',
} as Record<string, string>)[slug] || 'workflow';
---
<figure class:list={['service-illustration', { compact }]} data-illustration={kind} aria-label={steps.join(' → ')}>
  <svg class="illustration-canvas" viewBox="0 0 320 140" fill="none" aria-hidden="true">
    {kind === 'workflow' && <>
      <path class="track" d="M62 70h196" />
      <rect class="paper" x="16" y="42" width="66" height="56" rx="12" /><path class="ink" d="M32 58h34M32 68h24M32 78h17" />
      <rect class="tint" x="126" y="36" width="68" height="68" rx="18" /><path class="ink" d="m166 50-19 24h14l-6 16 20-25h-14l5-15Z" />
      <rect class="paper" x="238" y="42" width="66" height="56" rx="12" /><path class="ink reveal" d="m255 70 10 10 21-23" pathLength="1" />
      <circle class="traveler" cx="91" cy="70" r="4" />
    </>}
    {kind === 'conversation' && <>
      <rect class="paper bubble-in" x="26" y="18" width="198" height="48" rx="16" />
      <g class="ink bubble-in"><path d="M44 36h86M44 47h54" /><circle cx="198" cy="42" r="4" /></g>
      <rect class="tint bubble-out" x="96" y="80" width="198" height="48" rx="16" />
      <g class="ink bubble-out"><path d="M114 98h100M114 110h67m71-10 5 5 9-10m-6 10 9-10" /></g>
      <g class="typing"><circle cx="243" cy="61" r="3" /><circle cx="253" cy="61" r="3" /><circle cx="263" cy="61" r="3" /></g>
    </>}
    {kind === 'rewards' && <>
      <path class="track" d="M45 70h230" />
      {[0,1,2].map(i=><g class="stamp" style={`--step:${i}`}><circle class="paper" cx={40+i*66} cy="70" r="23" /><path class="ink" d={`m${31+i*66} 70 6 6 12-13`} /></g>)}
      <g class="reward"><rect class="tint" x="230" y="36" width="72" height="68" rx="18" /><path class="ink" d="m266 49 6 12 13 2-10 10 2 14-11-7-12 7 3-14-10-10 13-2 6-12Z" /></g>
    </>}
    {kind === 'play' && <>
      <g class="wheel"><circle class="paper" cx="102" cy="72" r="51" /><path class="tint" d="M102 72V21a51 51 0 0 1 44 76Z" /><path class="ink" d="M102 21v102M58 47l88 50M58 97l88-50" /><circle class="paper" cx="102" cy="72" r="12" /></g>
      <path class="solid" d="m92 13 10 18 10-18Z" />
      <path class="track" d="M170 72h33" />
      <g class="reward"><rect class="tint" x="212" y="44" width="84" height="57" rx="10" /><path class="ink" d="M228 61h52m-52 12h27m-27 12h35" /></g>
    </>}
    {kind === 'content' && <>
      <rect class="paper" x="37" y="18" width="123" height="109" rx="12" /><path class="ink write" d="M54 39h75M54 53h87M54 67h71M54 81h50M54 95h75" pathLength="1" />
      <g class="publish"><rect class="tint" x="183" y="31" width="99" height="88" rx="12" /><circle class="solid" cx="252" cy="52" r="7" /><path class="ink" d="m197 92 22-28 18 19 12-12 20 21H197Z" /></g>
    </>}
    {kind === 'agent' && <>
      <path class="track" d="M52 70h73m68 0h32l28-34m-28 34 28 34" />
      <circle class="paper" cx="38" cy="70" r="20" /><path class="ink" d="M30 66h16m-16 8h10" />
      <g class="thinking"><rect class="tint" x="124" y="37" width="68" height="66" rx="22" /><path class="ink" d="m158 50 6 14 14 6-14 6-6 14-6-14-14-6 14-6 6-14Z" /></g>
      <circle class="paper" cx="272" cy="33" r="20" /><path class="ink" d="M264 33h16m-8-8v16" />
      <g class="reward"><circle class="tint" cx="272" cy="107" r="20" /><path class="ink" d="m263 107 6 6 12-13" /></g>
      <circle class="traveler agent-traveler" cx="68" cy="70" r="4" />
    </>}
    {kind === 'documents' && <>
      <rect class="paper" x="32" y="20" width="86" height="102" rx="10" /><path class="ink" d="M48 41h52M48 55h38M48 69h52M48 83h27M48 97h42" />
      <path class="scan" d="M22 28h106" />
      <path class="track" d="M134 70h43" />
      <g class="publish"><rect class="tint" x="192" y="31" width="103" height="78" rx="12" /><path class="ink" d="M207 50h73m-73 19h73m-73 20h73M228 43v53" /></g>
    </>}
    {kind === 'learning' && <>
      <rect class="paper" x="23" y="27" width="115" height="79" rx="10" /><path class="ink" d="m69 48 25 18-25 18V48ZM51 117h60M81 106v11" />
      <path class="track" d="M153 70h29" />
      <g class="reward"><rect class="tint" x="202" y="29" width="91" height="83" rx="15" /><path class="ink" d="m224 71 15 15 27-30" /></g>
    </>}
  </svg>
  <figcaption><ol>{steps.map((step,i)=><li><span class="step-number">0{i+1}</span>{step}</li>)}</ol></figcaption>
</figure>

<style>
  .service-illustration { margin: 0; width: 100%; --ink: color-mix(in srgb, var(--service-accent) 38%, #222); }
  .illustration-canvas { display: block; width: 100%; height: auto; }
  .paper { fill: #fff; stroke: color-mix(in srgb, var(--service-accent) 20%, #ddd); stroke-width: 1.3; }
  .tint { fill: color-mix(in srgb, var(--service-accent) 18%, #fff); stroke: color-mix(in srgb, var(--service-accent) 45%, #fff); stroke-width: 1.3; }
  .ink { stroke: var(--ink); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .solid, .traveler, .typing { fill: var(--service-accent); }
  .track { stroke: color-mix(in srgb, var(--service-accent) 35%, #ddd); stroke-width: 1.5; stroke-dasharray: 3 5; }
  .scan { stroke: var(--service-accent); stroke-width: 2; animation: scan 4.8s ease-in-out infinite; }
  .traveler { animation: travel 4.8s ease-in-out infinite; }
  .agent-traveler { animation-name: agent-travel; }
  .reveal, .write { stroke-dasharray: 1; animation: write 4.8s ease-in-out infinite; }
  .bubble-in { animation: arrive 4.8s ease both infinite; }
  .bubble-out { animation: reply 4.8s ease both infinite; }
  .typing { animation: typing 4.8s ease infinite; }
  .stamp { animation: stamp 4.8s ease infinite; animation-delay: calc(var(--step) * .4s); }
  .reward { transform-box: fill-box; transform-origin: center; animation: reward 4.8s ease infinite; }
  .wheel { transform-origin: 102px 72px; animation: wheel 4.8s cubic-bezier(.18,.7,.2,1) infinite; }
  .publish { animation: publish 4.8s ease infinite; }
  .thinking { transform-box: fill-box; transform-origin: center; animation: think 4.8s ease infinite; }
  ol { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px; list-style: none; padding: 12px 0 0; margin: 0; border-top: 1px solid rgb(0 0 0 / .07); }
  li { color: #515151; font-size: 11px; line-height: 1.4; }
  .step-number { display: block; color: var(--ink); font-size: 9px; font-weight: 600; letter-spacing: .06em; margin-bottom: 4px; }
  .compact ol { gap: 8px; padding-top: 9px; }
  .compact li { font-size: 10px; }
  @media (max-width: 1023px) { .compact .illustration-canvas { height: 80px; } }
  @keyframes travel { 0%,10% { transform: translateX(0); opacity: 0; } 20% { opacity: 1; } 78% { opacity: 1; } 90%,100% { transform: translateX(138px); opacity: 0; } }
  @keyframes agent-travel { 0%,10% { transform: translateX(0); opacity: 0; } 20%,65% { opacity: 1; } 90%,100% { transform: translateX(157px); opacity: 0; } }
  @keyframes write { 0%,15% { stroke-dashoffset: 1; } 65%,100% { stroke-dashoffset: 0; } }
  @keyframes arrive { 0% { opacity: .2; transform: translateY(6px); } 20%,100% { opacity: 1; transform: none; } }
  @keyframes reply { 0%,35% { opacity: .15; transform: translateY(8px); } 65%,100% { opacity: 1; transform: none; } }
  @keyframes typing { 0%,20%,70%,100% { opacity: .1; } 40%,55% { opacity: 1; } }
  @keyframes stamp { 0%,15% { opacity: .35; } 35%,100% { opacity: 1; } }
  @keyframes reward { 0%,50% { transform: scale(.9); opacity: .45; } 70%,100% { transform: scale(1); opacity: 1; } }
  @keyframes wheel { 0%,10% { transform: rotate(0); } 75%,100% { transform: rotate(300deg); } }
  @keyframes publish { 0%,35% { opacity: .15; transform: translateX(-8px); } 70%,100% { opacity: 1; transform: none; } }
  @keyframes think { 0%,15%,85%,100% { transform: scale(1); } 45% { transform: scale(1.06); } }
  @keyframes scan { 0%,10% { transform: translateY(0); opacity: 0; } 20%,75% { opacity: 1; } 90%,100% { transform: translateY(85px); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .service-illustration * { animation: none !important; } .traveler, .scan, .typing { display: none; } }
</style>
