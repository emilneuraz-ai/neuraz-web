---
import MercuryLogo from './MercuryLogo.astro';
import ServicePreview from './ServicePreview.astro';
import { services } from '../data/services';
---
<div class="hero-logo" data-hero-logo>
  <MercuryLogo finish="resin" view="front" fluid={true} framing={1.17} controls={false} loading="eager" reducedMotion="static" label="Logo 3D de Neuraz. Arrastrá para girarlo." />
  <div class="service-preview-layer" data-service-preview-layer hidden>
    {services.map((service, index) => <ServicePreview service={service} index={index} />)}
  </div>
</div>
<script>
  import { installHeroLogos } from '../scripts/hero-logo';
  installHeroLogos();
</script>
<style>
  .hero-logo { position: relative; width: 100%; color: #111; }
  .service-preview-layer { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
  .service-preview-layer[hidden] { display: none; }
  @media (max-width: 1023px) { .service-preview-layer { display: none; } }
</style>
