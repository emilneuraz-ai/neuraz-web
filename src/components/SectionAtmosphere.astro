---
interface Props {
  variant?: 'hero' | 'grid' | 'contours' | 'dots' | 'closing';
}

const { variant = 'grid' } = Astro.props;
---

<div class:list={['section-atmosphere', `atmosphere-${variant}`]} aria-hidden="true" data-atmosphere>
  <div class="atmosphere-wash"></div>
  <div class="atmosphere-pattern"></div>
</div>

<style>
  :global(.ambient-section) { position: relative; isolation: isolate; }
  .section-atmosphere {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
  }
  .atmosphere-wash {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 96% 38%, #a3a3a312, transparent 58%);
  }
  .atmosphere-pattern {
    position: absolute;
    width: min(72vw, 880px);
    aspect-ratio: 1;
    right: -12%;
    top: -5%;
    background-image:
      linear-gradient(#77777710 1px, transparent 1px),
      linear-gradient(90deg, #77777710 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse at center, #0009 5%, #0005 32%, transparent 68%);
    animation: atmosphere-drift 36s ease-in-out infinite alternate;
    animation-play-state: paused;
  }
  [data-visible="true"] .atmosphere-pattern { animation-play-state: running; }
  .atmosphere-hero .atmosphere-wash {
    background:
      radial-gradient(ellipse at 4% 30%, #a3a3a310, transparent 52%),
      radial-gradient(ellipse at 92% 82%, #a3a3a30a, transparent 46%);
  }
  .atmosphere-hero .atmosphere-pattern {
    left: -20%;
    right: auto;
    top: -18%;
    background-image: repeating-radial-gradient(ellipse at center, transparent 0 39px, #77777712 40px, transparent 41px 72px);
    background-size: auto;
    animation-duration: 42s;
  }
  .atmosphere-contours .atmosphere-wash {
    background: radial-gradient(ellipse at 0% 78%, #99999913, transparent 60%);
  }
  .atmosphere-contours .atmosphere-pattern {
    left: -20%;
    right: auto;
    top: 8%;
    background-image: repeating-radial-gradient(ellipse at center, transparent 0 31px, #77777714 32px, transparent 33px 58px);
    background-size: auto;
    animation-duration: 44s;
    animation-direction: alternate-reverse;
  }
  .atmosphere-dots .atmosphere-pattern {
    top: -28%;
    background-image: radial-gradient(circle, #77777722 .8px, transparent 1px);
    background-size: 24px 24px;
    animation-duration: 40s;
  }
  .atmosphere-closing .atmosphere-wash {
    background: radial-gradient(ellipse at 72% 100%, #99999918, transparent 65%);
  }
  .atmosphere-closing .atmosphere-pattern {
    top: -10%;
    right: -8%;
    background-image: repeating-linear-gradient(135deg, transparent 0 31px, #77777713 32px, transparent 33px 64px);
    background-size: auto;
    animation-duration: 46s;
  }
  @keyframes atmosphere-drift {
    from { transform: translate3d(-10px, -8px, 0); opacity: .6; }
    to { transform: translate3d(14px, 12px, 0); opacity: 1; }
  }
  @media (max-width: 767px) {
    .atmosphere-pattern { width: 115vw; right: -48%; opacity: .65; }
    .atmosphere-hero .atmosphere-pattern { left: -56%; top: -4%; }
    .atmosphere-contours .atmosphere-pattern { left: -62%; top: 24%; }
    .atmosphere-dots .atmosphere-pattern { top: 4%; }
    .atmosphere-closing .atmosphere-pattern { right: -48%; top: 28%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .atmosphere-pattern { animation: none; opacity: .7; }
  }
</style>

<script>
  const layers = document.querySelectorAll<HTMLElement>('[data-atmosphere]');
  const visible = new Set<Element>();
  const sync = () => layers.forEach(layer => {
    layer.dataset.visible = String(visible.has(layer) && !document.hidden);
  });
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => entry.isIntersecting ? visible.add(entry.target) : visible.delete(entry.target));
    sync();
  });
  layers.forEach(layer => observer.observe(layer));
  document.addEventListener('visibilitychange', sync);
  document.addEventListener('astro:before-swap', () => {
    observer.disconnect();
    document.removeEventListener('visibilitychange', sync);
  }, { once: true });
</script>
