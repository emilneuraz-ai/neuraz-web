---
// src/layouts/ServiceModalLayout.astro - Layout for service pages displayed as modals
import '../styles/global.css';
import NavbarBrand from '../components/NavbarBrand.astro';
import PageLoader from '../components/PageLoader.astro';

interface Props {
  title: string;
  description?: string;
  category: string;
}

const { title, description = "Neuraz - Inteligencia Artificial Aplicada", category } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/images/isotipo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body class="bg-black/95 font-sans antialiased">
    <PageLoader variant="dark" />
    <!-- Modal container - fullscreen -->
    <div id="service-modal" class="service-modal fixed inset-0 z-50 flex" role="dialog" aria-modal="true" aria-label={title}>
      <!-- Backdrop -->
      <div id="modal-backdrop" class="absolute inset-0 bg-black"></div>
      
      <!-- Modal content - fullscreen -->
      <div class="service-modal__surface relative w-full h-full bg-black overflow-hidden">
        <!-- Scrollable content -->
        <div class="h-full w-full overflow-y-auto overflow-x-hidden">
          <!-- Close button -->
          <div class="sticky top-0 z-10 flex items-center justify-between gap-4 px-8 py-6 bg-black/95 backdrop-blur-sm border-b border-white/10">
            <div class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1">
              <NavbarBrand variant="dark" showWordmark={false} />
              <span class="text-[10px] font-medium tracking-[0.2em] text-white/40 uppercase">{category}</span>
            </div>
            
            <a 
              href="/#servicios" 
              id="close-modal"
              class="flex shrink-0 items-center gap-2 text-xs font-medium tracking-[0.15em] text-white/60 hover:text-white transition-colors"
            >
              CERRAR
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 6L6 18M6 6l12 12" stroke-linecap="square" stroke-linejoin="miter"/>
              </svg>
            </a>
          </div>
          
          <!-- Page content -->
          <div class="px-8 pb-12">
            <slot />
          </div>
        </div>
      </div>
    </div>
    
    <script>
      const modal = document.getElementById('service-modal');
      const closeButton = document.getElementById('close-modal');
      let closing = false;

      const closeModal = () => {
        if (closing) return;
        closing = true;
        modal?.setAttribute('data-closing', 'true');
        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.setTimeout(() => {
          let openedFromSite = false;
          try {
            openedFromSite = sessionStorage.getItem('serviceModalOpenedFromSite') === 'true';
            sessionStorage.removeItem('serviceModalOpenedFromSite');
          } catch { /* Browser storage is optional. */ }
          if (openedFromSite && history.length > 1) history.back();
          else window.location.href = '/#servicios';
        }, reduceMotion ? 0 : 220);
      };

      closeButton?.addEventListener('click', (event) => {
        event.preventDefault();
        closeModal();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeModal();
      });
      document.getElementById('modal-backdrop')?.addEventListener('click', closeModal);
      
      // Store the service ID in sessionStorage to reopen the accordion
      const serviceSlug = window.location.pathname.split('/').pop();
      if (serviceSlug) {
        sessionStorage.setItem('lastOpenedService', serviceSlug);
      }
    </script>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  
  body {
    font-feature-settings: "cv02", "cv03", "cv04", "cv11";
  }

  .service-modal {
    background: #050505;
    animation: service-modal-in 300ms cubic-bezier(.2,.75,.2,1) both;
  }

  .service-modal__surface {
    transform-origin: 50% 55%;
    animation: service-modal-surface-in 420ms cubic-bezier(.2,.75,.2,1) both;
  }

  .service-modal[data-closing='true'] {
    pointer-events: none;
    animation: service-modal-out 220ms ease both;
  }

  .service-modal[data-closing='true'] .service-modal__surface {
    animation: service-modal-surface-out 220ms ease both;
  }

  @keyframes service-modal-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes service-modal-out { from { opacity: 1; } to { opacity: 0; } }
  @keyframes service-modal-surface-in {
    from { opacity: 0; transform: translateY(18px) scale(.992); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes service-modal-surface-out {
    from { opacity: 1; transform: translateY(0) scale(1); }
    to { opacity: 0; transform: translateY(10px) scale(.994); }
  }
  
  /* Custom scrollbar for modal */
  .overflow-y-auto::-webkit-scrollbar {
    width: 8px;
  }
  
  .overflow-y-auto::-webkit-scrollbar-track {
    background: transparent;
  }
  
  .overflow-y-auto::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
  }
  
  .overflow-y-auto::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  @media (prefers-reduced-motion: reduce) {
    .service-modal,
    .service-modal__surface,
    .service-modal[data-closing='true'],
    .service-modal[data-closing='true'] .service-modal__surface { animation: none; }
  }
</style>
