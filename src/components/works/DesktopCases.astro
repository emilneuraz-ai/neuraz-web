---
import DemoFrame from './DemoFrame.astro';
interface Props {view:string; projectId:string;}
const {view,projectId}=Astro.props;
const products=['Detector de fugas y presión de radiador','Extractor de rodamientos internos','Llave crique extensible · 1/2','Multímetro digital inteligente'];
const pictures=['detector.jpg','extractor.jpg','crique.jpg','multimetro.jpg'];
---
<DemoFrame responsive label={`Presentación interactiva de ${projectId}`}>
<portfolio-demo class:list={['desktop-case',projectId,`view-${view}`]}>
{projectId==='eurotech-gestor' && <div class="admin-layout gestor">
 <aside class="sidebar"><div class="gestor-brand"><img src="/images/works/eurotech/logo.svg" alt="Eurotech"/><b>Gestor</b></div><strong>Global</strong><small>Gestión consolidada de<br/>Argentina y Uruguay</small><div class="countries"><b>Global</b><span>UY</span><span>AR</span></div>{['Dashboard global','Productos globales','Grupos globales','Usuarios','Documentación'].map((label,i)=><span class:list={['side-item',{selected:i===1}]}><span aria-hidden="true">{['◫','▦','▤','○','▧'][i]}</span>{label}</span>)}<div class="sidebar-bottom">EUROTECH / ADMINISTRACIÓN</div></aside>
 <div class="admin-main"><div class="mini-top">Espacio de trabajo <span>Global &nbsp; / &nbsp; Productos</span></div>
 {view==='catalogo' && <><p class="overline">CATÁLOGO CONSOLIDADO</p><h5>Productos globales</h5><p class="intro">Una vista de los productos de Argentina y Uruguay.</p><div class="metrics">{[['1.288','Productos globales'],['829','AR + UY'],['25','Solo Argentina'],['434','Solo Uruguay']].map(([n,label])=><div><b>{n}</b><small>{label}</small></div>)}</div><label class="search-field">⌕ <input data-demo-search placeholder="Buscar por nombre o SKU" aria-label="Buscar productos de la presentación"/></label><div class="table-toolbar"><strong>Catálogo</strong><span>Todos los estados &nbsp;⌄ &nbsp; Todas las categorías &nbsp;⌄</span></div><div class="product-table"><div class="table-row table-label"><span>PRODUCTO</span><span>ARGENTINA</span><span>URUGUAY</span><span>ESTADO</span></div>{products.map((name,i)=><div class="table-row" data-search-row><span class="product-name"><img src={`/images/works/eurotech/${pictures[i]}`} alt=""/><span>{name}<small>SKU {['5054','6534','5538','6544'][i]}</small></span></span><span class="tag">Vinculado</span><span class="tag">Vinculado</span><span class="status-dot">Publicado</span></div>)}</div><p class="demo-note">Catálogo de muestra · cifras del caso documentado</p></>}
 {view==='producto' && <><div class="edit-toolbar"><span>← Productos globales</span><button data-demo-action="Borrador guardado en esta demostración">Guardar borrador</button></div><div class="product-editor"><section><p class="overline">FICHA DE PRODUCTO</p><h5>Detector de fugas y presión de radiador</h5><span class="tag">PUBLICADO</span><p class="intro">SKU 5054 · Medición y prueba</p><div class="form-card"><b>Título y contenido</b><label>Nombre del producto<input value="Detector de fugas y presión de radiador"/></label><label>Categoría<select aria-label="Categoría de producto"><option>Medición y prueba</option><option>Herramientas manuales</option></select></label></div><div class="form-card"><b>Precios · Uruguay</b><div class="price-fields"><label>Precio regular<input value="4.665" inputmode="decimal"/></label><label>Precio contado<input value="4.385" inputmode="decimal"/></label></div><small>Valores del catálogo de demostración, expresados en UYU.</small></div></section><aside class="product-photo"><img src="/images/works/eurotech/detector.jpg" alt="Kit detector de fugas de radiador"/><small>Galería del producto</small><div class="source-chip">WooCommerce <span>↗</span></div><div class="source-chip">Mercado Libre <span>↗</span></div></aside></div><p class="demo-feedback" aria-live="polite"></p></>}
 {view==='sync' && <><p class="overline">INTEGRACIONES</p><h5>Centro de sincronización</h5><p class="intro">Fuentes, catálogo y tiendas en un mismo recorrido.</p><div class="sync-diagram"><div><span class="integration-symbol">ML</span><strong>Mercado Libre</strong><small>Fuente de productos</small></div><span class="moving-arrow">→</span><div><span class="integration-symbol red">E</span><strong>Catálogo Eurotech</strong><small>Contenido y clasificación</small></div><span class="moving-arrow">→</span><div><span class="integration-symbol purple">W</span><strong>WooCommerce</strong><small>Tiendas AR / UY</small></div></div><div class="form-card"><div class="table-toolbar"><strong>Revisar fuentes</strong><span class="tag">Vista de ejemplo</span></div>{['Mercado Libre · Uruguay','WooCommerce · Uruguay','WooCommerce · Argentina'].map(label=><div class="source-row"><span>{label}</span><button data-demo-action={`Revisión de ${label}: simulación local completada`}>Revisar →</button></div>)}</div><p class="demo-feedback" aria-live="polite">Las acciones de esta presentación no modifican las tiendas.</p></>}
 </div></div>}
{projectId==='west' && <div class="west-app"><header><img src="/images/works/west/isologotipo-horizontal.svg" alt="West"/><nav>Inicio &nbsp;&nbsp;&nbsp; Propiedades &nbsp;&nbsp;&nbsp; Contacto ↗</nav></header>
 {view==='inicio' && <section class="west-hero"><span>Gestión desarrollista e inmobiliaria</span><h5>Orientamos<br/>tus inversiones.</h5><img src="/images/works/west/isotipo.svg" alt=""/><span class="west-scroll">Conocé West &nbsp;↓</span></section>}
 {view==='equipo' && <section class="west-team"><div><span>Somos un equipo de profesionales</span><h5>Somos tu socio<br/>de confianza.</h5><p>Acompañamos el desarrollo de proyectos inmobiliarios con una mirada integral.</p><div class="west-line"></div><span>Visión. Experiencia. Compromiso.</span></div><img src="/images/works/west/west-about.jpg" alt="Profesional trabajando con un plano arquitectónico" loading="lazy"/></section>}
 {view==='proceso' && <section class="west-process"><span>UNA VISIÓN INTEGRAL</span><h5>El camino de un proyecto.</h5><div>{['proceso-1.jpg','proceso-2.jpg','proceso-3.jpg'].map((img,i)=><article><img src={`/images/works/west/${img}`} alt={['Planificación del desarrollo','Etapa de construcción','Gestión del proyecto'][i]} loading="lazy"/><span>0{i+1}</span><h6>{['Planificación','Desarrollo','Gestión'][i]}</h6></article>)}</div></section>}
 <footer>WEST / GESTIÓN DESARROLLISTA E INMOBILIARIA <span>↗</span></footer></div>}
{projectId==='kronos' && <div class="kronos-app"><header><img src="/images/works/kronos/logo.svg" alt="Kronos OCR"/><span>Hoja Protocolo</span><nav>Probar extracción &nbsp;&nbsp; Configuración &nbsp;&nbsp; API</nav></header>
 {view==='flujos' && <div class="kronos-main"><span class="overline">ESPACIO DE TRABAJO</span><h5>Mis Flujos</h5><p>Gestiona tus configuraciones de extracción inteligente.</p><div class="flow-search"><label class="search-field">⌕ <input data-demo-search aria-label="Buscar flujos" placeholder="Buscar flujos…"/></label><button data-demo-action="Esta presentación muestra flujos de ejemplo">+ Nuevo flujo</button></div><div class="flows">{['Hoja Protocolo','Extracción semántica','Redacción periodística','SAT Reporte'].map((title,i)=><article data-search-row><span>FLUJO / 0{i+1}</span><h6>{title}</h6><p>Configuración de extracción</p><div>Contexto &nbsp; · &nbsp; Estructura <span>→</span></div></article>)}</div><p class="demo-feedback" aria-live="polite"></p></div>}
 {view==='config' && <div class="kronos-main"><div class="edit-toolbar"><h5>Configuración</h5><button data-demo-action="Configuración guardada solo en esta demostración">Guardar cambios</button></div><div class="kronos-columns"><section><div class="form-card"><b>METADATOS Y CONTEXTO</b><label>Modelo<select aria-label="Modelo de extracción"><option>Gemini 3.1 Flash Lite</option></select></label><label>Objetivo<input value="Extraer la información del documento"/></label><label>Contexto<input value="Documentos y hojas de protocolo"/></label></div><div class="form-card"><b>Detalle</b><p>Describe qué datos debe reconocer el flujo.</p></div></section><section class="schema"><div>ESTRUCTURA <span>PROMPT GENERADO</span></div>{[['paginas_escaneadas','Array'],['folio_impreso','String'],['folio','String'],['pagina_protocolo','String'],['orientacion','String'],['renglones','Array']].map(([name,type])=><details><summary><span>⌘</span> {name}<small>{type}</small></summary><p>Campo de salida del documento.</p></details>)}</section></div><p class="demo-feedback" aria-live="polite"></p></div>}
 {view==='extraer' && <div class="kronos-main"><div class="edit-toolbar"><h5>Probar extracción</h5><span class="tag">Ejemplo local</span></div><div class="kronos-columns"><section><div class="upload-box"><span>↥</span><h6>Prueba con un documento</h6><p>Ejecutá el ejemplo para explorar el resultado.</p><button data-demo-extract>Extraer ejemplo →</button></div><div class="extraction-output" aria-live="polite"><span>RESULTADO</span><pre data-extract-output>Sin datos · esperando el ejemplo</pre></div></section><section class="form-card"><b>Funciones de procesamiento</b>{['Extraer texto de escritura','Dividir contenido','Extraer número de folio','Procesar contenido','Reestructurar JSON'].map((item,i)=><label class="check-row"><input type="checkbox" checked={i===0}/>{item}</label>)}<p class="demo-note">No se cargan documentos ni se envían datos.</p></section></div></div>}
 </div>}
{projectId==='las-mil-novedades' && <div class="admin-layout lmn-app"><aside class="sidebar"><img class="lmn-logo" src="/images/works/lmn/logo.png" alt="Las Mil Novedades"/><small>Sistema de asociados</small>{['Inicio','Tienda','Mis Compras','Historial de Puntos','Catálogo de Canjes','Mis Referidos'].map((item,i)=><span class:list={['side-item',{selected:i===(view==='inicio'?0:view==='canjes'?4:2)}]}><span aria-hidden="true">{['⌂','▦','▧','◷','◇','♧'][i]}</span>{item}</span>)}<div class="sidebar-bottom">Tu cuenta &nbsp; / &nbsp; Configuración</div></aside><div class="admin-main"><div class="mini-top">Mi cuenta <span>Programa de asociados</span></div>
 {view==='inicio' && <><h5>¡Hola! 👋</h5><p class="intro">Este es el resumen de tu cuenta.</p><div class="loyalty-grid"><div class="wallet"><span>MIS PUNTOS</span><strong>155 <small>pts</small></strong><div>Nivel <b>BRONCE</b></div><div class="wallet-progress"><i></i></div><small>Seguí sumando con tus compras.</small></div><div class="form-card"><span>ÚLTIMA COMPRA</span><h6>Tu actividad,<br/>siempre a mano.</h6><p>Consultá tu historial de compras y movimientos.</p></div></div><div class="loyalty-shortcuts">{['Mis compras','Historial de puntos','Mis referidos'].map((label,i)=><div><span>{['▧','◷','♧'][i]}</span><b>{label}</b><span>↗</span></div>)}</div><div class="yellow-banner"><div><b>Canje destacado</b><p>Explorá los beneficios del programa.</p></div><span>→</span></div><p class="demo-note">Cuenta ilustrativa · puntos del diseño de referencia</p></>}
 {view==='canjes' && <><h5>Canjear Beneficios</h5><p class="intro">Usá tus puntos para obtener lo que querés.</p><label class="search-field">⌕ <input data-demo-search aria-label="Buscar premio" placeholder="Buscar premio…"/></label><div class="report-tabs"><button data-demo-choice aria-pressed="true">Todos</button><button data-demo-choice aria-pressed="false">Pruebas</button></div><div class="reward-grid"><article data-search-row><div class="reward-art"><span>◇</span><b>100 PTS</b></div><small>PRUEBAS</small><h6>Premio prueba</h6><button data-demo-action="Premio de prueba seleccionado; no se realiza un canje">Ver canje →</button></article></div><p class="demo-feedback" aria-live="polite">Premio de prueba del prototipo de referencia.</p></>}
 {view==='actividad' && <><h5>Mis Compras</h5><p class="intro">Un lugar para seguir tu actividad.</p><div class="report-tabs"><button data-demo-choice aria-pressed="true">Compras</button><button data-demo-choice aria-pressed="false">Puntos</button></div><div class="activity-summary"><span>HISTORIAL DE TU CUENTA</span><b>Cada movimiento, en orden.</b></div><div class="activity-list">{['Compra registrada','Puntos acreditados','Nivel del programa'].map((name,i)=><div><span class="activity-icon">{['▧','+','★'][i]}</span><div><b>{name}</b><small>Registro de demostración</small></div><span>{['Ver detalle →','155 pts','Bronce'][i]}</span></div>)}</div><p class="demo-feedback" aria-live="polite">Información ilustrativa del sistema de asociados.</p></>}
 </div></div>}
</portfolio-demo>
</DemoFrame>
