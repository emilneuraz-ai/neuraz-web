---
interface Props { class?: string; }
const { class: className } = Astro.props;
---
<div class:list={['spherical-logo', className]} data-spherical-logo>
  <div class="sphere-stage" data-sphere-stage tabindex="0" role="group" aria-label="Logo esférico de Neuraz. Arrastrá o usá las flechas para girarlo; R vuelve a la vista del SVG.">
    <img src="/images/isotipo.svg" alt="Neuraz" width="129" height="130" class="sphere-fallback" />
    <canvas data-sphere-canvas aria-hidden="true"></canvas>
  </div>
  <div class="sphere-actions">
    <button data-sphere-demo>Ver transformación <span aria-hidden="true">↗</span></button>
    <button data-sphere-horizontal>45° horizontal</button>
    <button data-sphere-vertical>45° vertical</button>
    <button data-sphere-reset>Vista del logo <span aria-hidden="true">↺</span></button>
  </div>
  <p class="sphere-angles" data-sphere-angles>Horizontal 0° · Vertical 0°</p>
</div>
<script>
  import { installSphericalLogos } from '../scripts/spherical-logo';
  installSphericalLogos();
</script>
<style>
  .spherical-logo { width: 100%; }
  .sphere-stage { position:relative; aspect-ratio:1; width:100%; touch-action:pan-y; cursor:grab; }
  .sphere-stage:active { cursor:grabbing; }
  .sphere-stage:focus-visible { outline:1px solid #777; outline-offset:4px; border-radius:16px; }
  canvas { position:absolute; inset:0; width:100%; height:100%; }
  .sphere-fallback { position:absolute; inset:8.5%; width:83%; height:83%; object-fit:contain; }
  [data-ready='true'] .sphere-fallback { visibility:hidden; }
  .sphere-angles { text-align:center; font-size:11px; color:#777; margin-top:14px; }
  .sphere-actions { display:flex; justify-content:center; flex-wrap:wrap; gap:12px; }
  button { min-height:44px; border:1px solid #ddd; border-radius:24px; background:transparent; padding:0 16px; color:#111; font:inherit; font-size:12px; cursor:pointer; }
  button:hover { border-color:#111; }
  button span { margin-left:12px; }
</style>
