---
import isotipo from '../../public/images/isotipo.svg?raw';
import conversation from '../assets/heroicons/chat-bubble-left-ellipsis.svg?raw';
import document from '../assets/heroicons/document-text.svg?raw';
import tasks from '../assets/heroicons/queue-list.svg?raw';
import response from '../assets/heroicons/chat-bubble-left-right.svg?raw';
import organizedDocument from '../assets/heroicons/document-check.svg?raw';
import completedTasks from '../assets/heroicons/clipboard-document-check.svg?raw';
import pause from '../assets/heroicons/pause.svg?raw';
import play from '../assets/heroicons/play.svg?raw';

const steps = [
  { number: '01', label: 'Conectamos', detail: 'Consultas, documentos y tareas.' },
  { number: '02', label: 'Automatizamos', detail: 'Un sistema hecho para vos.' },
  { number: '03', label: 'Simplificamos', detail: 'Respuestas, información y acciones.' },
];

// Keep the original brand geometry and the library SVGs as the source of truth.
const brandPaths = [...isotipo.matchAll(/<path\s+d="([^"]+)"/g)].map((match) => match[1]);
const iconContent = (svg: string) => svg
  .replace(/^[\s\S]*?<svg\b[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '')
  .replaceAll('<path', '<path pathLength="1"');
const inputs = [conversation, document, tasks];
const outputs = [response, organizedDocument, completedTasks];
const positions = [{ x: 32, y: 80 }, { x: 10, y: 186 }, { x: 32, y: 292 }];
---

<figure class="system" data-hero-system>
  <div class="system-heading">
    <span>Tu operación, conectada.</span>
    <button class="motion-toggle" type="button" aria-label="Pausar animación" aria-pressed="false" hidden>
      <svg class="pause-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={iconContent(pause)} />
      <svg class="play-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={iconContent(play)} />
    </button>
  </div>

  <svg class="system-art" viewBox="0 0 560 420" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="hero-system-title" aria-describedby="hero-system-description">
    <title id="hero-system-title">Neuraz conecta y automatiza tu operación</title>
    <desc id="hero-system-description">Los contornos de los iconos de consultas, documentos y tareas se dibujan y rellenan. Las conexiones llegan al isotipo de Neuraz, cuyos trazos se construyen y completan. Del sistema salen respuestas, documentos organizados y tareas resueltas.</desc>

    <g class="route-guides" stroke="#e0e0e0" stroke-width="1.25">
      <path d="M91 108H122Q144 108 144 130V184Q144 206 166 206H175" />
      <path d="M69 214H175" />
      <path d="M91 320H122Q144 320 144 298V244Q144 222 166 222H175" />
      <path d="M393 206H402Q424 206 424 184V130Q424 108 446 108H471" />
      <path d="M393 214H493" />
      <path d="M393 222H402Q424 222 424 244V298Q424 320 446 320H471" />
    </g>
    <g class="route-ink" stroke="currentColor" stroke-width="1.25">
      <path class="route route-in" d="M91 108H122Q144 108 144 130V184Q144 206 166 206H175" pathLength="1" />
      <path class="route route-in" d="M69 214H175" pathLength="1" />
      <path class="route route-in" d="M91 320H122Q144 320 144 298V244Q144 222 166 222H175" pathLength="1" />
      <path class="route route-out" d="M393 206H402Q424 206 424 184V130Q424 108 446 108H471" pathLength="1" />
      <path class="route route-out" d="M393 214H493" pathLength="1" />
      <path class="route route-out" d="M393 222H402Q424 222 424 244V298Q424 320 446 320H471" pathLength="1" />
    </g>

    {inputs.map((icon, index) => (
      <svg class="library-icon input-icon" x={positions[index].x} y={positions[index].y} width="58" height="58" viewBox="0 0 24 24" style={`--icon-delay: ${index * 0.12}s`}>
        <g class="icon-guide" set:html={iconContent(icon)} />
        <g class="icon-ink" set:html={iconContent(icon)} />
      </svg>
    ))}

    <!-- The actual Neuraz isotipo, with every original path preserved. -->
    <svg class="brand-mark" x="158" y="86" width="250" height="252" viewBox="0 0 129 130">
      <g class="brand-guide">
        {brandPaths.map((path) => <path d={path} />)}
      </g>
      <g class="brand-ink">
        {brandPaths.map((path, index) => (
          <path class={`brand-path brand-path-${index + 1}`} d={path} pathLength="1" style={`--part-delay: ${index * 0.08}s`} />
        ))}
      </g>
    </svg>

    {outputs.map((icon, index) => (
      <svg class="library-icon output-icon" x={index === 1 ? 492 : 470} y={positions[index].y} width="58" height="58" viewBox="0 0 24 24" style={`--icon-delay: ${index * 0.12}s`}>
        <g class="icon-guide" set:html={iconContent(icon)} />
        <g class="icon-ink" set:html={iconContent(icon)} />
      </svg>
    ))}
  </svg>

  <figcaption>
    <ol class="system-steps">
      {steps.map((step, index) => (
        <li class={`system-step step-${index + 1}`}>
          <span class="step-number">{step.number}</span>
          <span class="step-label">{step.label}</span>
        </li>
      ))}
    </ol>
    <div class="system-caption">
      <p>De tareas repetitivas a trabajo resuelto.</p>
      <div class="caption-sequence" aria-hidden="true">
        {steps.map((step, index) => <span class={`caption-phase phase-${index + 1}`}>{step.detail}</span>)}
      </div>
    </div>
  </figcaption>
</figure>

<style>
  .system { --cycle: 10.8s; margin: 0; color: #111; }
  .system-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 36px;
    font-size: 11px;
    color: #666;
  }
  .motion-toggle {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-right: -8px;
    border: 0;
    padding: 0;
    background: transparent;
    color: #666;
    cursor: pointer;
  }
  .motion-toggle[hidden] { display: none; }
  .motion-toggle:hover { color: #e63946; }
  .motion-toggle:focus-visible { outline: 2px solid #e63946; outline-offset: 2px; }
  .motion-toggle svg { width: 12px; height: 12px; fill: currentColor; }
  .play-icon, .system[data-paused="true"] .pause-icon { display: none; }
  .system[data-paused="true"] .play-icon { display: block; }
  .system-art { display: block; width: 100%; height: auto; overflow: visible; }
  .library-icon { overflow: visible; }
  .icon-guide :global(path) { fill: none; stroke: #d9d9d9; stroke-width: 0.35; }
  .icon-ink :global(path) {
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 0.35;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .brand-guide { fill: none; stroke: #dedede; stroke-width: 0.55; }
  .brand-path {
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 0.55;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .route { opacity: 0.55; }
  .system-steps {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1.1fr;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.875rem;
  }
  .system-step {
    position: relative;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    border-top: 1px solid #d8d8d8;
    padding-top: 0.875rem;
    font-size: 11px;
  }
  .system-step::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: #e63946;
    transform: scaleX(0);
    transform-origin: left;
  }
  .step-number { color: #767676; font-size: 9px; font-variant-numeric: tabular-nums; }
  .step-label { font-weight: 500; }
  .system-caption { margin-top: 1.4rem; min-height: 2.75rem; font-size: 11px; line-height: 1.7; }
  .system-caption p { margin: 0; }
  .caption-sequence { display: grid; color: #707070; }
  .caption-phase { grid-area: 1 / 1; opacity: 0; }
  .phase-3 { opacity: 1; }


  /* Contour first, fill second. All phases share a clock and hold before reset.
     The complete solid composition remains visible without JS or with reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .system[data-ready] .icon-ink :global(path) {
      stroke-dasharray: 1;
      animation: icon-input var(--cycle) ease-in-out infinite both;
      animation-delay: var(--icon-delay, 0s);
    }
    .system[data-ready] .output-icon .icon-ink :global(path) { animation-name: icon-output; }
    .system[data-ready] .brand-path {
      stroke-dasharray: 1;
      animation: brand-draw var(--cycle) ease-in-out infinite both;
      animation-delay: var(--part-delay, 0s);
    }
    .system[data-ready] .brand-path-6 { animation-name: brand-draw, brand-accent; }
    .system[data-ready] .route {
      stroke-dasharray: 1;
      animation: route-in var(--cycle) ease-in-out infinite both;
    }
    .system[data-ready] .route-out { animation-name: route-out; }
    .system[data-ready] .system-step::before { animation: step-progress var(--cycle) linear infinite; }
    .system[data-ready] .step-2::before { animation-delay: 3.6s; }
    .system[data-ready] .step-3::before { animation-delay: 7.2s; }
    .system[data-ready] .caption-phase { animation: caption var(--cycle) infinite; opacity: 0; }
    .system[data-ready] .phase-2 { animation-delay: 3.6s; }
    .system[data-ready] .phase-3 { animation-delay: 7.2s; }

    /* Descendants inserted from library SVGs are intentionally unscoped. */
    .system[data-ready][data-paused="true"] :global(*),
    .system[data-ready][data-paused="true"] *::before,
    .system[data-ready][data-suspended="true"] :global(*),
    .system[data-ready][data-suspended="true"] *::before { animation-play-state: paused !important; }
  }

  @keyframes icon-input {
    0%, 3% { stroke-dashoffset: 1; fill-opacity: 0; stroke-opacity: 1; }
    17% { stroke-dashoffset: 0; fill-opacity: 0; }
    25%, 87% { stroke-dashoffset: 0; fill-opacity: 1; stroke-opacity: 1; }
    96%, 100% { stroke-dashoffset: 0; fill-opacity: 0; stroke-opacity: 0; }
  }
  @keyframes route-in {
    0%, 19% { stroke-dashoffset: 1; opacity: 0; }
    22% { opacity: 0.55; }
    34%, 87% { stroke-dashoffset: 0; opacity: 0.55; }
    96%, 100% { stroke-dashoffset: 0; opacity: 0; }
  }
  @keyframes brand-draw {
    0%, 28% { stroke-dashoffset: 1; fill-opacity: 0; stroke-opacity: 1; }
    49% { stroke-dashoffset: 0; fill-opacity: 0; }
    60%, 85% { stroke-dashoffset: 0; fill-opacity: 1; stroke-opacity: 1; }
    94%, 100% { stroke-dashoffset: 0; fill-opacity: 0; stroke-opacity: 0; }
  }
  @keyframes brand-accent {
    0%, 28%, 86%, 100% { fill: #111; stroke: #111; }
    40%, 65% { fill: #e63946; stroke: #e63946; }
  }
  @keyframes route-out {
    0%, 57% { stroke-dashoffset: 1; opacity: 0; }
    60% { opacity: 0.55; }
    69%, 87% { stroke-dashoffset: 0; opacity: 0.55; }
    96%, 100% { stroke-dashoffset: 0; opacity: 0; }
  }
  @keyframes icon-output {
    0%, 65% { stroke-dashoffset: 1; fill-opacity: 0; stroke-opacity: 1; }
    76% { stroke-dashoffset: 0; fill-opacity: 0; }
    83%, 89% { stroke-dashoffset: 0; fill-opacity: 1; stroke-opacity: 1; }
    97%, 100% { stroke-dashoffset: 0; fill-opacity: 0; stroke-opacity: 0; }
  }
  @keyframes step-progress {
    0% { transform: scaleX(0); opacity: 1; }
    30% { transform: scaleX(1); opacity: 1; }
    33%, 100% { transform: scaleX(1); opacity: 0; }
  }
  @keyframes caption {
    0%, 3%, 29% { opacity: 1; transform: translateY(0); }
    33%, 96% { opacity: 0; transform: translateY(3px); }
    100% { opacity: 0; transform: translateY(0); }
  }
  @media (max-width: 1023px) and (min-width: 700px) {
    .system-steps { gap: 0.65rem; }
    .system-step { flex-direction: column; gap: 0.25rem; font-size: 10px; }
    .system-heading, .system-caption { font-size: 10px; }
  }
  @media (max-width: 380px) {
    .system-steps { gap: 0.65rem; }
    .system-step { flex-direction: column; gap: 0.25rem; font-size: 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .motion-toggle { display: none; }
  }
</style>

<script>
  const system = document.querySelector<HTMLElement>('[data-hero-system]');
  if (system) {
    const toggle = system.querySelector<HTMLButtonElement>('.motion-toggle');
    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
    let inView = false;

    const updatePlayback = () => {
      system.dataset.suspended = String(!inView || document.hidden || motionPreference.matches);
    };
    const togglePlayback = () => {
      const paused = system.dataset.paused !== 'true';
      system.dataset.paused = String(paused);
      toggle?.setAttribute('aria-pressed', String(paused));
      toggle?.setAttribute('aria-label', paused ? 'Reanudar animación' : 'Pausar animación');
    };
    const observer = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      updatePlayback();
    }, { threshold: 0.15 });

    updatePlayback();
    system.dataset.ready = '';
    if (toggle) toggle.hidden = false;
    observer.observe(system);
    toggle?.addEventListener('click', togglePlayback);
    document.addEventListener('visibilitychange', updatePlayback);
    motionPreference.addEventListener('change', updatePlayback);

    document.addEventListener('astro:before-swap', () => {
      observer.disconnect();
      toggle?.removeEventListener('click', togglePlayback);
      document.removeEventListener('visibilitychange', updatePlayback);
      motionPreference.removeEventListener('change', updatePlayback);
    }, { once: true });
  }
</script>
