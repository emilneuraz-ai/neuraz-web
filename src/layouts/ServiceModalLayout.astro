---
import '../styles/global.css';
import NavbarBrand from '../components/NavbarBrand.astro';
import ServiceOverview from '../components/ServiceOverview.astro';
import { services, serviceVisual } from '../data/services';
import { serviceDetails } from '../data/serviceDetails';

interface Props {
  title: string;
  description?: string;
  category: string;
}

const { title, category } = Astro.props;
const slug = Astro.url.pathname.split('/').filter(Boolean).pop()!;
const detail = serviceDetails[slug];
const description = Astro.props.description ?? detail.intro;
const index = services.findIndex(service => service.slug === slug);
const color = serviceVisual(index >= 0 ? index : 4).color;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/images/isotipo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;650;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="service-modal-page" style={`--service-accent: ${color}`}>
    <dialog id="service-modal" class="service-modal" open aria-labelledby="service-title" aria-describedby="service-intro">
      <div class="service-modal__surface">
        <header class="service-modal__header">
          <div class="service-modal__brand">
            <NavbarBrand showWordmark={false} size={32} />
            <span class="service-modal__category"><i aria-hidden="true"></i>{category}</span>
          </div>
          <a href="/#servicios" id="close-modal" class="service-modal__close" aria-label="Cerrar servicio" autofocus>
            <span>Cerrar</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
          </a>
        </header>
        <main class="service-modal__content">
          <ServiceOverview slug={slug} title={title.replace(' | Neuraz', '')} detail={detail} />
        </main>
      </div>
    </dialog>
    <script>
      const modal = document.querySelector<HTMLDialogElement>('#service-modal');
      const closeButton = document.getElementById('close-modal');
      let closing = false;
      let startedOutside = false;

      // Native modal semantics keep keyboard focus inside the panel.
      if (modal) {
        modal.removeAttribute('open');
        modal.showModal();
      }

      const closeModal = () => {
        if (closing) return;
        closing = true;
        modal?.setAttribute('data-closing', 'true');
        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.setTimeout(() => {
          let openedFromSite = false;
          try {
            openedFromSite = sessionStorage.getItem('serviceModalOpenedFromSite') === 'true';
            sessionStorage.removeItem('serviceModalOpenedFromSite');
          } catch { /* Browser storage is optional. */ }
          if (openedFromSite && history.length > 1) history.back();
          else window.location.href = '/#servicios';
        }, reduceMotion ? 0 : 180);
      };

      closeButton?.addEventListener('click', event => {
        event.preventDefault();
        closeModal();
      });
      modal?.addEventListener('cancel', event => {
        event.preventDefault();
        closeModal();
      });
      const isOutside = (event: MouseEvent) => {
        if (!modal || event.target !== modal) return false;
        const rect = modal.getBoundingClientRect();
        return event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom;
      };
      modal?.addEventListener('pointerdown', event => { startedOutside = isOutside(event); });
      modal?.addEventListener('pointercancel', () => { startedOutside = false; });
      modal?.addEventListener('click', event => {
        if (startedOutside && isOutside(event)) closeModal();
        startedOutside = false;
      });
      // A restored history entry must be usable again after its exit animation.
      window.addEventListener('pageshow', () => {
        closing = false;
        modal?.removeAttribute('data-closing');
      });
      try {
        const slug = window.location.pathname.split('/').filter(Boolean).pop();
        if (slug) sessionStorage.setItem('lastOpenedService', slug);
      } catch { /* Browser storage is optional. */ }
    </script>
  </body>
</html>

<style>
  .service-modal-page { overflow: hidden; background: #e8e7e4; font-feature-settings: 'cv02', 'cv03', 'cv04', 'cv11'; }
  .service-modal {
    position: fixed; inset: 0; margin: auto;
    width: min(1040px, calc(100% - 96px)); max-width: none;
    max-height: calc(100dvh - 80px); padding: 0;
    border: 1px solid rgb(255 255 255 / .65); border-radius: 24px;
    background: #fafafa; color: #1a1a1a;
    box-shadow: 0 32px 100px rgb(0 0 0 / .2);
    overflow: auto; overscroll-behavior: contain;
    animation: panel-in 320ms cubic-bezier(.2,.75,.2,1) both;
    scrollbar-width: thin; scrollbar-color: #b8b8b8 transparent;
  }
  .service-modal::backdrop { background: rgb(24 27 30 / .42); backdrop-filter: blur(12px); animation: backdrop-in 220ms ease both; }
  .service-modal__header { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 32px; border-bottom: 1px solid #e5e5e5; background: #fafafa; position: sticky; top: 0; z-index: 2; }
  .service-modal__brand { display: flex; align-items: center; gap: 20px; min-width: 0; }
  .service-modal__category { display: flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 500; letter-spacing: .07em; text-transform: uppercase; }
  .service-modal__category i { width: 7px; height: 7px; flex: none; border-radius: 50%; background: var(--service-accent); }
  .service-modal__close { display: flex; align-items: center; justify-content: center; gap: 10px; min-width: 44px; min-height: 44px; padding: 0 13px; border-radius: 24px; color: #444; font-size: 12px; text-decoration: none; transition: background 150ms; }
  .service-modal__close:hover { background: color-mix(in srgb, var(--service-accent) 12%, white); color: #111; }
  .service-modal__close:focus-visible { outline: 2px solid #222; outline-offset: 3px; }
  .service-modal__content { padding: 32px; }
  .service-modal[data-closing='true'] { pointer-events: none; animation: panel-out 180ms ease both; }
  .service-modal[data-closing='true']::backdrop { animation: backdrop-out 180ms ease both; }
  @keyframes panel-in { from { opacity: 0; transform: translateY(16px) scale(.98); } to { opacity: 1; transform: none; } }
  @keyframes panel-out { to { opacity: 0; transform: translateY(10px) scale(.985); } }
  @keyframes backdrop-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes backdrop-out { to { opacity: 0; } }
  @media (max-width: 640px) {
    .service-modal { width: calc(100% - 24px); max-height: calc(100dvh - 32px); border-radius: 20px; }
    .service-modal__header { padding: 10px 16px; gap: 8px; }
    .service-modal__brand { gap: 10px; }
    .service-modal__category { font-size: 9px; letter-spacing: .035em; }
    .service-modal__close { padding: 0; flex: none; }
    .service-modal__close span { display: none; }
    .service-modal__content { padding: 22px 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .service-modal, .service-modal::backdrop, .service-modal[data-closing='true'], .service-modal[data-closing='true']::backdrop { animation: none; }
    .service-modal__close { transition: none; }
  }
</style>
