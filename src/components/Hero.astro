---
import SectionAtmosphere from './SectionAtmosphere.astro';
---

<section class="hero ambient-section" aria-labelledby="hero-title">
  <SectionAtmosphere variant="hero" />
  <div class="hero-inner">
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 id="hero-title">
          <span class="hero-outline">Diseñamos</span>
          <span>sistemas</span>
          <span>inteligentes</span>
        </h1>
        <p class="hero-description">
          Conectamos tus herramientas y automatizamos lo repetitivo.
          Más tiempo para lo que hacés mejor.
        </p>
        <nav class="hero-actions" aria-label="Explorar Neuraz">
          <a class="hero-button" href="#servicios">Servicios <span aria-hidden="true">→</span></a>
          <a class="hero-button hero-button-outline" href="#trabajos">Proyectos <span aria-hidden="true">↗</span></a>
          <a class="hero-team-link" href="#equipo">El equipo <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
      <div class="hero-visual">
        <div class="hero-logo-slot" data-hero-logo-slot><img src="/images/isotipo.svg" alt="Neuraz" width="440" height="440" /></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-actions { position:relative; z-index:201; display:flex; align-items:center; gap:12px; }
  .hero-actions a { display:inline-flex; align-items:center; justify-content:center; gap:12px; min-height:44px; font-size:13px; white-space:nowrap; }
  .hero-button { border:1px solid #111; background:#111; color:#fafafa; padding:0 20px; border-radius:999px; }
  .hero-button-outline { background:transparent; color:#111; }
  .hero-team-link { padding-inline:8px; text-decoration:underline; text-underline-offset:4px; }
  @media(max-width:767px){.hero-actions{gap:8px;justify-content:flex-start}.hero-actions a{font-size:11px;gap:6px}.hero-button{padding:0 12px}.hero-team-link{padding-inline:0}}
  @media(max-width:359px){.hero-actions{gap:6px}.hero-actions a{font-size:10px}.hero-button{padding:0 9px}}

  .hero {
    --hero-gutter: clamp(2rem, 6vw, 7.5rem);
    padding: 6.5rem var(--hero-gutter) 0;
    background: #fafafa;
    color: #111;
    display: flex;
  }
  .hero { isolation: auto; }
  .hero :global(.section-atmosphere) { z-index: 0; }
  .hero-logo-slot { width: 100%; aspect-ratio: 1; }
  .hero-logo-slot img { width: 100%; height: 100%; object-fit: contain; padding: 12%; }
  .hero-logo-slot[data-shared-ready="true"] img { visibility: hidden; }
  .hero-inner {
    width: 100%;
    max-width: 1648px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: center;
    flex: 1;
    padding-bottom: 1.5rem;
  }
  .hero-copy {
    grid-column: 1 / 7;
    grid-row: 1;
    position: relative;
    z-index: 200;
    pointer-events: none;
  }
  .hero-copy a { pointer-events: auto; }
  h1 {
    margin: 0;
    font-size: clamp(4.5rem, 8.1vw, 8rem);
    font-weight: 600;
    line-height: 0.99;
    letter-spacing: -0.065em;
  }
  h1 > span { display: block; }
  @supports (-webkit-text-stroke: 1px #111) {
    .hero-outline {
      color: #fafafa;
      -webkit-text-fill-color: #fafafa;
      -webkit-text-stroke: 2px #111;
      paint-order: stroke fill;
    }
  }
  .hero-description {
    max-width: 350px;
    margin: 1.75rem 0 1.5rem;
    color: #666;
    font-size: 14px;
    line-height: 1.7;
    text-wrap: pretty;
  }
  .hero a:focus-visible { outline: 2px solid #e63946; outline-offset: 6px; }
  .hero-visual {
    grid-column: 6 / -1;
    grid-row: 1;
    min-width: 0;
    width: 100%;
    margin-left: 0;
  }
  @media (min-width: 1024px) {
    .hero {
      min-height: 100svh;
      padding-top: 5rem;
    }
    .hero-inner { flex: 1; }
    .hero-grid { min-height: 0; padding-bottom: 0; }
    .hero-visual {
      position: absolute;
      grid-column: auto;
      grid-row: auto;
      right: 0;
      top: 50%;
      width: 52.5%;
      transform: translateY(-50%);
    }
  }
  @media (max-width: 1023px) {
    .hero { padding-top: 6.5rem; }
    .hero-grid { grid-template-columns: minmax(0, 1fr); }
    .hero-copy { grid-column: 1; grid-row: 1; }
    .hero-visual { grid-column: 1; grid-row: 2; margin-top: 12px; }
    h1 { font-size: clamp(3rem, 7.7vw, 5rem); }
    .hero-description { font-size: 13px; max-width: 310px; }
  }
  @media (max-width: 767px) {
    .hero { --hero-gutter: clamp(1.75rem, 8vw, 2.5rem); padding: 6.5rem var(--hero-gutter) 0; }
    .hero-grid { grid-template-columns: minmax(0, 1fr); gap: 0; padding-bottom: 1.5rem; }
    .hero-copy { grid-column: 1; grid-row: 1; }
    h1 { font-size: clamp(2.35rem, 15.4vw, 9rem); }
    @supports (font-size: 1cqi) {
      .hero-copy { container-type: inline-size; }
      h1 { font-size: 19.2cqi; }
    }
    .hero-outline { -webkit-text-stroke-width: 1.5px; }
    .hero-description { margin-top: 1.5rem; max-width: 330px; }
    .hero-visual {
      grid-column: 1;
      grid-row: 2;
      width: calc((100% + 2 * var(--hero-gutter) - 24px) * .9);
      max-width: 648px;
      margin: 12px 0 0;
      justify-self: center;
    }
  }
  @media (forced-colors: active) {
    .hero-outline { color: CanvasText; -webkit-text-fill-color: CanvasText; -webkit-text-stroke-width: 0; }
  }
</style>
