---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HeroLogo from '../components/HeroLogo.astro';
import Services from '../components/Services.astro';
import Works from '../components/Works.astro';
import About from '../components/About.astro';
import Team from '../components/Team.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Neuraz - Tecnología con propósito">
  <Header />
  <main>
    <Hero />
    <Services />
    <Works />
    <About />
    <Team />
    <Contact />
  </main>
  
  <div class="shared-logo-host" data-shared-logo-host hidden><HeroLogo /></div>
  <Footer />
</Layout>

<style>
  .shared-logo-host { position: fixed; z-index: 20; pointer-events: none; }
  @media (min-width: 1024px) {
    .shared-logo-host { position: absolute; top: 0; left: 0; will-change: transform; }
  }
  .shared-logo-host[hidden] { display: none; }
  .shared-logo-host :global([data-mercury-stage]) { pointer-events: auto; }
</style>
<script>
  import { installSharedLogo } from '../scripts/shared-logo';
  installSharedLogo();
</script>
