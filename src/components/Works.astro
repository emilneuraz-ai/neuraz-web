---
import DeviceFrame from './works/DeviceFrame.astro';
import ScreenCapture from './works/ScreenCapture.astro';
import WestView from './works/WestView.astro';
import GestorView from './works/GestorView.astro';
import DesktopCases from './works/DesktopCases.astro';
import MobileCases from './works/MobileCases.astro';
import {gestor,cafe,shell,west,kronos,noticias} from '../data/works/additional-projects';
import ProjectStory from './works/ProjectStory.astro';
import EurotechView from './works/EurotechView.astro';
import AclimatarView from './works/AclimatarView.astro';
import { aclimatarTanzania } from '../data/works/aclimatar-tanzania';
import { eurotech } from '../data/works/eurotech';
const stories = [{project:eurotech,View:EurotechView},{project:gestor,View:GestorView},{project:cafe,View:DesktopCases},{project:aclimatarTanzania,View:AclimatarView},{project:shell,View:MobileCases},{project:west,View:WestView},{project:kronos,View:DesktopCases},{project:noticias,View:MobileCases}].map(({project,View})=>({project:{...project,theme:'light' as const},View}));
---
<section id="trabajos" class="works" aria-labelledby="works-title">
  <h2 id="works-title" class="sr-only">Trabajos seleccionados</h2>
  <div class="works-viewport" style={`--works-wash:${stories[0].project.accent}`}>
  <div class="works-background" aria-hidden="true"><div class="works-wash"></div></div>
  <div class="works-track">
  {stories.map(({ project, View }) => <ProjectStory project={project}>
    <div slot="copy" class="scene-copy" data-scene-copy>
      <p class="scene-eyebrow">{project.category}</p><h4 id={`title-${project.id}`}>{project.title}</h4>
      <p class="scene-description">{project.scenes[0].description}</p>
    </div>
    {project.scenes.map(scene => <section class:list={['work-scene',{'work-presentation':project.format==='presentation'}]} data-work-scene={scene.id} aria-labelledby={`scene-${project.id}-${scene.id}`}>
      <div class="scene-visual">
        <div class="scene-demo" data-scene-demo>{project.format==='presentation' && scene.image ? <ScreenCapture image={scene.image} /> : <DeviceFrame phone={scene.device==='mobile'||project.format==='mobile'} capturedStatus={scene.device==='mobile'} responsive={project.format!=='mobile'&&!scene.image} label={project.title} theme={project.theme || 'dark'}>{scene.image ? <ScreenCapture image={scene.image} scrollable={true} viewport={scene.device || (project.format==='mobile' ? 'mobile' : 'desktop')} /> : <View view={scene.id} projectId={project.id} />}</DeviceFrame>}</div>
      </div>
      <h4 class="sr-only" id={`scene-${project.id}-${scene.id}`}>{project.title} · {scene.label}</h4>
    </section>)}
  </ProjectStory>)}
  </div>
  <a class="works-exit works-exit-before" href="#servicios" data-works-exit aria-label="Volver a Servicios. También podés deslizar hacia abajo aquí."><span aria-hidden="true">↓</span> Volver a Servicios</a>
  <a class="works-exit works-exit-after" href="#nosotros" data-works-exit aria-label="Continuar a Nosotros. También podés deslizar hacia arriba aquí.">Continuar a Nosotros <span aria-hidden="true">↑</span></a>
  </div>
  <nav class="work-positions" aria-label="Posición entre proyectos" hidden>{stories.map(({project},i)=><a href={`#trabajo-${project.id}`} data-project-jump aria-label={`Proyecto ${i+1}: ${project.title}`}><span></span><span class="work-position-label">{project.title}</span></a>)}</nav>

</section>
<style>
.works-background{position:absolute;inset:0;pointer-events:none;overflow:clip;mask-image:linear-gradient(180deg,transparent,#000 22%,#000 78%,transparent)}
.works-wash{display:none;position:absolute;inset:-12%;pointer-events:none;background:radial-gradient(ellipse at 76% 44%,color-mix(in srgb,var(--works-wash) 15%,transparent) 0%,transparent 52%),radial-gradient(ellipse at 23% 74%,color-mix(in srgb,var(--works-wash) 7%,transparent) 0%,transparent 48%);filter:blur(35px);animation:works-wash-drift 16s ease-in-out infinite alternate;animation-play-state:paused}
.works[data-horizontal] .works-wash{display:block}.works[data-visible="true"] .works-wash{animation-play-state:running}
.works[data-horizontal] .works-track{position:relative;z-index:1}
.works[data-horizontal] .works-track :global(project-story),.works[data-horizontal] .works-track :global(.story-stage){background:transparent}
.works[data-horizontal] .works-track :global(.story-wash){display:none}
@keyframes works-wash-drift{from{transform:translate3d(-2%,1%,0) scale(1)}to{transform:translate3d(3%,-3%,0) scale(1.1)}}
.works[data-horizontal]{height:var(--works-height)}.works[data-horizontal] .works-viewport{position:sticky;top:80px;height:var(--works-viewport-height);overflow:clip}.works[data-horizontal] .works-track{display:flex;width:100%;height:100%;will-change:transform}.works[data-horizontal] .works-track :global(project-story){flex:0 0 100%;min-width:0;width:100%;--story-height:var(--works-viewport-height)}
.works{position:relative;scroll-margin-top:80px;background:var(--color-bg,#fafafa)}.work-scene{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0;padding:0;min-height:620px;width:100%}.scene-visual{position:relative;width:100%;max-width:1050px;min-width:0;display:flex;align-items:center;justify-content:center}.scene-demo{position:relative;width:100%;transform:scale(var(--demo-scale,1));transform-origin:top center;margin-bottom:calc(var(--demo-natural-height,0px) * (var(--demo-scale,1) - 1))}.scene-copy{width:min(100%,760px);color:var(--work-ink)}.scene-title-row{display:flex;justify-content:space-between;align-items:center;gap:28px}.scene-eyebrow{font-size:9px;letter-spacing:.12em;text-transform:uppercase;line-height:1.5;margin-bottom:6px;color:var(--work-ink)}.scene-copy h4{font-size:26px;letter-spacing:-.04em;line-height:1.15;font-weight:450}.scene-description{font-size:12px;line-height:1.6;max-width:72ch;margin-top:12px;color:var(--work-ink)}:global(project-story[data-enhanced]) .work-scene{height:100%;min-height:0}.work-positions{position:fixed;right:14px;top:50%;transform:translateY(-50%);z-index:45;display:grid;transition:opacity 180ms;color:var(--position-ink,#000)}.work-positions[hidden]{display:none}.work-positions a{width:28px;height:25px;display:grid;place-items:center;position:relative}.work-positions a>span:first-child{width:4px;height:4px;background:currentColor;opacity:.3;border-radius:50%}.work-positions a[aria-current]>span:first-child{width:6px;height:6px;opacity:1;outline:1px solid currentColor;outline-offset:4px}.work-position-label{position:absolute;right:34px;background:var(--position-bg,#fff);border:1px solid currentColor;padding:5px 9px;font-size:10px;white-space:nowrap;opacity:0;pointer-events:none}.work-positions a:hover .work-position-label,.work-positions a:focus-visible .work-position-label{opacity:1}.work-positions a:focus-visible{outline:1px solid currentColor;outline-offset:3px}
@media(min-width:768px){.scene-copy{width:100%;max-width:430px}.scene-eyebrow{font-size:12px;letter-spacing:.14em;margin-bottom:20px}.scene-copy h4{font-size:clamp(34px,3.3vw,62px);font-weight:450;line-height:1.05;letter-spacing:-.045em}.scene-description{font-size:clamp(17px,1.35vw,22px);line-height:1.6;margin-top:24px}.scene-project-link{display:inline-flex;gap:20px;align-items:center;margin-top:30px;font-size:13px;border-bottom:1px solid currentColor;padding-bottom:7px}.scene-project-link span{font-size:20px}}
.scene-project-link{color:var(--work-ink)}
.work-scene{padding:40px 40px 64px}
.work-scene.work-presentation{justify-content:center;gap:0;padding:0}.work-presentation .scene-visual{width:min(100%,446px);max-width:446px;flex:none}
@media(max-width:767px){.scene-copy{width:100%}.scene-copy h4{font-size:24px}.scene-description{font-size:13px;line-height:1.5;margin-top:10px}.scene-eyebrow{display:none}.scene-project-link{display:none}.scene-title-row{gap:10px}.work-positions{right:2px}.work-positions a{width:24px;height:23px}.work-position-label{display:none}}
@media(prefers-reduced-motion:reduce){.work-positions{transition:none}}
@media(max-width:767px){.work-scene{padding:24px 24px 28px}}

.works-exit{display:none}
@media(max-width:767px){.works-exit{position:absolute;left:16px;right:28px;z-index:3;display:flex;align-items:center;justify-content:center;gap:10px;min-height:40px;color:#111;font-size:10px;letter-spacing:.04em;touch-action:none}.works-exit-before{top:0;border-bottom:1px solid #00000026}.works-exit-after{bottom:0;border-top:1px solid #00000026}.works-exit:focus-visible{outline:2px solid currentColor;outline-offset:-3px}}
</style>

<script>
const works=document.querySelector<HTMLElement>('#trabajos')!;
const viewport=works.querySelector<HTMLElement>('.works-viewport')!;
const track=works.querySelector<HTMLElement>('.works-track')!;
const positionNav=works.querySelector<HTMLElement>('.work-positions')!;
const projects=Array.from(works.querySelectorAll<HTMLElement>('project-story'));
const projectColors=projects.map(project=>{
 const hex=project.style.getPropertyValue('--work-accent').trim();
 return [1,3,5].map(index=>parseInt(hex.slice(index,index+2),16));
});
function blendBackground(position:number){
 const index=Math.floor(position),blend=position-index;
 const from=projectColors[index],to=projectColors[Math.min(index+1,projectColors.length-1)];
 const color=from.map((channel,i)=>Math.round(channel+(to[i]-channel)*blend));
 viewport.style.setProperty('--works-wash',`rgb(${color.join(',')})`);
}
let viewportVisible=false;
function syncBackgroundVisibility(){works.dataset.visible=String(viewportVisible&&!document.hidden);}
const backgroundVisibility=new IntersectionObserver(entries=>{viewportVisible=!!entries[0]?.isIntersecting;syncBackgroundVisibility();});
backgroundVisibility.observe(viewport);
document.addEventListener('visibilitychange',syncBackgroundVisibility);
document.addEventListener('astro:before-swap',()=>{backgroundVisibility.disconnect();document.removeEventListener('visibilitychange',syncBackgroundVisibility);},{once:true});
const reduced=matchMedia('(prefers-reduced-motion:reduce)');
let step=0, pending=0;
let settleTimer:ReturnType<typeof setTimeout>|undefined;
let programmaticUntil=0;
let touching=false;
function measure(){
 const height=Math.max(620,innerHeight-80);
 step=Math.max(620,innerHeight*.85);
 works.toggleAttribute('data-horizontal',!reduced.matches);
 works.style.setProperty('--works-viewport-height',`${height}px`);
 works.style.setProperty('--works-height',`${height+(projects.length-1)*step}px`);
 updatePosition();
}
function projectTop(index:number){
 return reduced.matches?projects[index].getBoundingClientRect().top+scrollY-80:works.getBoundingClientRect().top+scrollY-80+index*step;
}
works.addEventListener('click',event=>{
 const link=(event.target as Element).closest<HTMLAnchorElement>('[data-project-jump],[data-works-exit]');
 if(!link)return;const target=document.getElementById(link.hash.slice(1));if(!target)return;
 event.preventDefault();history.replaceState(null,'',link.hash);
 clearTimeout(settleTimer);programmaticUntil=performance.now()+1200;
 const index=projects.indexOf(target);
 // Focus the persistent navigation while travelling; offscreen project content stays inert.
 if(index<0){target.setAttribute('tabindex','-1');target.focus({preventScroll:true});}
 window.scrollTo({top:index<0?target.getBoundingClientRect().top+scrollY-80:projectTop(index),behavior:reduced.matches?'instant':'smooth'});
});
// The outer strips remain available even while a screenshot is scrolling.
works.querySelectorAll<HTMLElement>('[data-works-exit]').forEach(zone=>{
 let startY:number|undefined;
 zone.addEventListener('touchstart',event=>{startY=event.touches[0]?.clientY;},{passive:true});
 zone.addEventListener('touchmove',event=>{if(startY!==undefined)event.preventDefault();},{passive:false});
 zone.addEventListener('touchend',event=>{
  const delta=(event.changedTouches[0]?.clientY??startY??0)-(startY??0);startY=undefined;
  if(Math.abs(delta)<24)return;
  const link=works.querySelector<HTMLAnchorElement>(delta>0?'.works-exit-before':'.works-exit-after');link?.click();
 });
 zone.addEventListener('touchcancel',()=>{startY=undefined;},{passive:true});
});
function updatePosition(){
 pending=0;
 const bounds=works.getBoundingClientRect();const midpoint=(innerHeight+80)/2;
 positionNav.hidden=bounds.top>midpoint||bounds.bottom<midpoint;
 let active=0;
 if(!reduced.matches){
   const progress=Math.max(0,Math.min(projects.length-1,(80-bounds.top)/step));
   const base=Math.floor(progress),fraction=progress-base;
   // A short resting interval keeps each project readable before the next horizontal slide.
   const travel=Math.max(0,Math.min(1,(fraction-.2)/.6));
   const eased=travel*travel*(3-2*travel);
   const position=base+eased;
   blendBackground(position);
   active=Math.min(projects.length-1,Math.round(position));
   const offset=-position*viewport.clientWidth;
   track.style.transform=`translate3d(${offset}px,0,0)`;
 }else{
   track.style.transform='';
   let distance=Infinity;
   projects.forEach((project,i)=>{const rect=project.getBoundingClientRect();const d=Math.abs(rect.top+rect.height/2-midpoint);if(d<distance){distance=d;active=i;}});
 }
 projects.forEach((project,i)=>{project.inert=!reduced.matches&&i!==active;});
 const dark=projects[active].dataset.theme==='dark';
 positionNav.style.setProperty('--position-ink',dark?'#fff':'#000');positionNav.style.setProperty('--position-bg',dark?'#000':'#fff');
 positionNav.querySelectorAll('a').forEach((link,i)=>{if(i===active)link.setAttribute('aria-current','step');else link.removeAttribute('aria-current');});
}
const queue=()=>{if(!pending)pending=requestAnimationFrame(updatePosition);};
function restoreProjectHash(){const index=projects.findIndex(project=>`#${project.id}`===location.hash);if(index>=0)window.scrollTo({top:projectTop(index),behavior:'instant'});}
function settleProject(){
 if(reduced.matches||touching||performance.now()<programmaticUntil)return;
 const progress=(80-works.getBoundingClientRect().top)/step;
 if(progress<=0||progress>=projects.length-1)return;
 const index=Math.round(progress);
 if(Math.abs(progress-index)<.015)return;
 programmaticUntil=performance.now()+650;
 window.scrollTo({top:projectTop(index),behavior:'smooth'});
}
window.addEventListener('scroll',()=>{queue();clearTimeout(settleTimer);settleTimer=setTimeout(settleProject,180);},{passive:true});
window.addEventListener('wheel',()=>{programmaticUntil=0;},{passive:true});
window.addEventListener('touchstart',()=>{touching=true;clearTimeout(settleTimer);programmaticUntil=0;},{passive:true});
window.addEventListener('touchend',()=>{touching=false;clearTimeout(settleTimer);settleTimer=setTimeout(settleProject,180);},{passive:true});
window.addEventListener('touchcancel',()=>{touching=false;},{passive:true});
window.addEventListener('resize',measure,{passive:true});
window.addEventListener('hashchange',restoreProjectHash);
reduced.addEventListener('change',measure);
measure();
// Wait for the shared page layout to settle before restoring a direct project link.
window.addEventListener('load',()=>{measure();restoreProjectHash();},{once:true});
</script>
