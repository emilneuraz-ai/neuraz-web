---
import DemoFrame from './DemoFrame.astro';
interface Props {view:string; projectId:string;}
const {view,projectId}=Astro.props;
---
<DemoFrame mobile label={`Presentación móvil de ${projectId}`}>
<mobile-portfolio-demo class:list={['mobile-case',projectId,`view-${view}`]}>
{projectId==='shell-puntos' && <div class="shell-app"><header><div class="shell-logo"><svg viewBox="0 0 60 55" role="img" aria-label="Shell"><path d="M12 42L4 31Q2 6 30 3Q58 6 56 31L48 42H37L34 49H26L23 42Z" fill="#ffdf00" stroke="#dc251b" stroke-width="4"/><path d="M27 40L12 17M30 40V7M33 40L48 17M24 40L7 30M36 40L53 30" stroke="#dc251b" stroke-width="2"/></svg><b>Calid</b></div><span>Descargar App ↗</span></header><div class="shell-content">
 {view==='inicio' && <><div class="shell-campaign"><span>SHELL PUNTOS</span><h5>Navidad<br/>sobre ruedas</h5><p>Sumá puntos. Descubrí beneficios.</p><div class="campaign-wheel" aria-hidden="true">✳</div></div><div class="shell-points"><span>TUS PUNTOS</span><strong>3.245 <small>pts</small></strong><button data-local-message="Explorá los premios en la siguiente vista">Canjear mis puntos →</button></div><div class="chance-card"><b>2</b><div>Chances acumuladas<small>Seguí participando</small></div><span>↗</span></div><button class="qr-button" data-local-message="Lector QR ilustrativo; no se abre la cámara"><span aria-hidden="true">▦</span> Escanear código QR</button></>}
 {view==='premios' && <><h5>Canjeá tus puntos</h5><div class="shell-tabs"><span>Premios</span><span>Mis canjes</span></div><p class="balance">Disponibles <b>3.245 puntos</b></p><div class="shell-rewards">{[['10%','Descuento en supermercado'],['☕','Desayunos'],['GNC','Carga de GNC']].map(([symbol,name])=><article><span>{symbol}</span><div><b>{name}</b><small>1.000 puntos</small><button data-local-message={`${name}: selección de ejemplo, sin realizar un canje`}>Ver premio ↗</button></div></article>)}</div></>}
 {view==='cargas' && <><h5>Mis cargas</h5><div class="shell-total"><span>TOTAL DEL PERÍODO</span><strong>$41.590,08</strong><small>Historial del diseño de referencia</small></div><div class="period-tabs"><button data-period aria-pressed="true">Este mes</button><button data-period aria-pressed="false">Mes pasado</button></div>{[['Combustible','$23.000'],['Combustible','$9.000'],['Otros consumos','$110']].map(([label,value],i)=><div class="fuel-row"><span aria-hidden="true">▣</span><div><b>{label}</b><small>Registro 0{i+1} · Ejemplo</small></div><strong>{value}</strong></div>)}<div class="shell-help"><b>Tu actividad, siempre a mano.</b><p>Revisá tus cargas y los puntos del programa.</p></div></>}
 <p class="mobile-feedback" aria-live="polite">Demostración del diseño · beneficios no vigentes</p></div><footer><span>⌂<small>Inicio</small></span><span>▧<small>Mis cargas</small></span><span class="shell-qr">▦</span><span>◇<small>Canjear</small></span><span>☰<small>Menú</small></span></footer></div>}
{projectId==='legend-bots' && <div class="legend-app"><header><b>THE LEGEND <span>BOTS</span></b><span>☰</span></header><div class="legend-content"><div class="bot-title"><span>BOT 1062</span><b>ADA / USDT</b></div>
 {view==='inicio' && <><h5>Todo listo.<br/>Paso a paso.</h5><p class="legend-intro">Prepará tu cuenta antes de configurar el bot.</p><div class="setup-steps">{[['01','Autenticación de dos factores','Protección de la cuenta'],['02','Conectar exchange','Vinculación de la plataforma'],['03','Configurar el bot','Revisión de parámetros']].map(([n,title,desc],i)=><div><span>{n}</span><div><b>{title}</b><small>{desc}</small></div><span>{i===0?'✓':'→'}</span></div>)}</div><div class="legend-callout"><span>SEGURIDAD</span><p>La configuración guía al usuario a través de cada etapa.</p></div><button class="gold-button" data-local-message="Paso de ejemplo seleccionado; no se conecta ninguna cuenta">Explorar configuración →</button></>}
 {view==='config' && <><h5>Configuración</h5><p class="legend-intro">Revisá los parámetros de la operación.</p><div class="exchange"><span>EXCHANGE</span><b>Binance</b><span>⌄</span></div><div class="bot-fields">{[['Presupuesto (USD)','152'],['Stop loss (%)','20'],['Límite de operaciones','15']].map(([label,value])=><label>{label}<input type="number" min="0" value={value}/></label>)}</div><div class="legend-callout"><span>VISTA DE DEMOSTRACIÓN</span><p>Los valores permiten explorar el diseño. No se envían órdenes ni se opera con fondos.</p></div><button class="gold-button" data-local-message="Parámetros guardados en esta demostración">Guardar configuración</button></>}
 {view==='panel' && <><div class="bot-state"><span>ESTADO DEL BOT</span><b data-bot-status>Pausado</b><button class="bot-toggle" data-bot-toggle aria-label="Cambiar estado simulado del bot" aria-pressed="false"><span></span></button></div><div class="bot-chart"><div><span>ACTIVIDAD</span><b>Vista de seguimiento</b></div><svg viewBox="0 0 300 115" aria-label="Gráfico decorativo de actividad" role="img">{[34,68,53,88,63,51,79,98,82,107,95,115,85,102].map((n,i)=><g stroke={i%3===0?'#6c6964':'#c8a667'}><path d={`M${10+i*21} ${120-n}v${n*.6}`} stroke-width="1"/><path d={`M${10+i*21} ${128-n}v${n*.35}`} stroke-width="8"/></g>)}</svg></div><div class="bot-stats">{[['152 USD','Presupuesto'],['20%','Stop loss'],['15','Límite'],['0','Operaciones']].map(([n,label])=><div><b>{n}</b><small>{label}</small></div>)}</div><div class="legend-callout"><span>HISTORIAL</span><p>Sin operaciones en esta presentación.</p></div><button class="gold-button" data-local-message="Panel de actividad de ejemplo">Ver actividad →</button></>}
 <p class="mobile-feedback" aria-live="polite">Simulación visual · sin conexión a plataformas financieras</p></div></div>}
</mobile-portfolio-demo>
</DemoFrame>
<style>
.mobile-case{display:block;width:360px;height:680px;font:13px/1.5 Arial,sans-serif}.mobile-case h5{font-size:29px;line-height:1.08;letter-spacing:-.035em;margin:18px 0 14px;font-weight:650}.mobile-case button{cursor:pointer}.mobile-case small{font-size:10px}.mobile-feedback{font-size:9px;line-height:1.4;opacity:.65;margin-top:14px;min-height:26px}.shell-app{height:100%;background:#fff;color:#333;position:relative}.shell-app header{display:flex;justify-content:space-between;align-items:center;background:#d72322;color:#fff;padding:14px 20px;height:70px}.shell-logo{display:flex;align-items:center;gap:8px}.shell-logo svg{width:39px;height:37px}.shell-logo b{font-size:18px;font-style:italic}.shell-app header>span{background:#ffdb15;color:#333;font-size:9px;padding:7px 10px;border-radius:5px}.shell-content{padding:18px 21px}.shell-campaign{position:relative;background:#d52722;border-radius:12px;padding:18px;color:#fff;overflow:hidden}.shell-campaign>span{font-size:9px;letter-spacing:.12em}.shell-campaign h5{font-size:33px;position:relative;z-index:1;margin:9px 0}.shell-campaign p{font-size:10px;position:relative;z-index:1}.campaign-wheel{position:absolute;right:-20px;top:15px;font-size:155px;line-height:1;color:#ffdb1580;animation:wheel 30s linear infinite}.shell-points{border:1px solid #e4e4e4;border-radius:12px;padding:16px;margin-top:14px}.shell-points>span{font-size:9px;color:#777}.shell-points strong{display:block;font-size:37px;line-height:1.1;margin:6px 0 12px}.shell-points small{font-size:14px;font-weight:400}.shell-points button,.shell-rewards button{background:#ffdc16;color:#222;border-radius:5px;padding:8px 12px;font-size:10px}.chance-card{display:flex;align-items:center;gap:15px;border:1px solid #eee;border-radius:10px;padding:14px;margin:14px 0}.chance-card>b{font-size:29px;color:#d52520}.chance-card small{display:block;color:#aaa;font-size:9px}.chance-card>span{margin-left:auto}.qr-button{display:flex;align-items:center;justify-content:center;gap:10px;background:#ffdc16;border-radius:7px;padding:10px;width:100%;font-size:12px;font-weight:bold}.qr-button>span{font-size:20px}.shell-app footer{position:absolute;bottom:0;left:0;right:0;display:flex;align-items:center;justify-content:space-around;height:65px;background:#fff;border-top:1px solid #ddd}.shell-app footer>span{text-align:center;font-size:22px}.shell-app footer small{display:block;font-size:8px;color:#777}.shell-qr{background:#d72420;color:#fff;border-radius:50%;width:47px;height:47px;display:grid;place-items:center}.shell-tabs{display:flex;gap:25px;border-bottom:1px solid #ddd;margin:20px 0 12px}.shell-tabs span{padding:8px 0}.shell-tabs span:first-child{border-bottom:2px solid #d5241e;color:#d5241e}.balance{font-size:11px;color:#777;display:flex;justify-content:space-between}.balance b{color:#333}.shell-rewards article{display:flex;gap:15px;align-items:center;border:1px solid #e7e7e7;border-radius:10px;padding:15px;margin-top:14px}.shell-rewards article>span{width:75px;height:82px;background:#fff7cc;border-radius:8px;display:grid;place-items:center;font-size:26px;font-weight:bold;flex:none}.shell-rewards b{font-size:12px}.shell-rewards small{display:block;color:#d32321;margin:5px 0 8px}.shell-rewards button{padding:6px 10px}.shell-total{padding:23px 0;border-bottom:1px solid #eee}.shell-total>span{font-size:9px;color:#888;letter-spacing:.1em}.shell-total strong{display:block;font-size:36px;margin:5px 0}.shell-total small{color:#aaa}.period-tabs{display:flex;gap:10px;margin:20px 0}.period-tabs button{border:1px solid #ddd;padding:8px 13px;border-radius:20px;font-size:11px}.period-tabs button[aria-pressed=true]{background:#ffdf23;border-color:#ffdf23}.fuel-row{display:flex;align-items:center;gap:12px;padding:17px 0;border-bottom:1px solid #eee;font-size:11px}.fuel-row>span{font-size:22px;color:#d72322}.fuel-row small{display:block;color:#999;font-size:9px}.fuel-row>strong{margin-left:auto}.shell-help{margin-top:24px;font-size:11px;background:#fff8d8;padding:15px;border-radius:8px}.shell-help p{color:#777;margin-top:5px}.legend-app{height:100%;background:#101010;color:#e5e3df}.legend-app header{height:64px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ffffff17;padding:0 23px;font-size:10px;letter-spacing:.12em}.legend-app header b>span{color:#c9ab70}.legend-content{padding:22px}.bot-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}.bot-title>span{font-size:9px;color:#9c8e73}.bot-title b{color:#d0b37b;font-size:12px}.legend-app h5{font-size:31px;font-weight:450}.legend-intro{color:#93928f;font-size:12px;line-height:1.7}.setup-steps{margin-top:26px}.setup-steps>div{display:flex;align-items:center;gap:14px;padding:19px 0;border-bottom:1px solid #ffffff18}.setup-steps>div>span:first-child{width:29px;height:29px;border:1px solid #cbae7260;border-radius:50%;display:grid;place-items:center;color:#cbae72;font-size:10px}.setup-steps>div>span:last-child{margin-left:auto;color:#cbae72}.setup-steps b{font-size:12px;font-weight:400}.setup-steps small{display:block;color:#74716b;margin-top:4px;font-size:10px}.legend-callout{background:#1d1b17;border:1px solid #cbae7225;padding:16px;border-radius:7px;margin:22px 0}.legend-callout>span{font-size:8px;color:#c7ab73;letter-spacing:.1em}.legend-callout p{font-size:11px;line-height:1.7;color:#a8a197;margin-top:7px}.gold-button{width:100%;padding:12px;background:#c5a469;color:#161410;border-radius:5px;font-size:12px}.exchange{display:flex;align-items:center;gap:14px;border:1px solid #ffffff25;border-radius:5px;padding:14px;margin:23px 0}.exchange>span:first-child{font-size:8px;color:#928773}.exchange b{font-size:12px;color:#d4b979}.exchange>span:last-child{margin-left:auto}.bot-fields label{display:flex;align-items:center;justify-content:space-between;font-size:11px;color:#aba59c;padding:12px 0;border-bottom:1px solid #ffffff15}.bot-fields input{width:94px;background:#191919;border:1px solid #ffffff25;border-radius:5px;padding:9px;color:#d7bd86;text-align:right}.bot-state{display:flex;align-items:center;gap:12px;border:1px solid #ffffff25;border-radius:8px;padding:15px}.bot-state>span{font-size:8px;color:#938874}.bot-state b{font-size:11px;color:#c7a874}.bot-toggle{width:36px;height:20px;background:#39342b;border-radius:20px;padding:3px;margin-left:auto}.bot-toggle>span{display:block;width:14px;height:14px;border-radius:50%;background:#bd9c62;transition:transform .2s}.bot-toggle[aria-pressed=true]{background:#c8a76b}.bot-toggle[aria-pressed=true]>span{transform:translateX(16px);background:#24211c}.bot-chart{margin-top:22px;background:#191816;padding:16px;border-radius:7px}.bot-chart>div>span{font-size:8px;color:#9b865e}.bot-chart b{display:block;font-size:12px;font-weight:400;margin-top:7px}.bot-chart svg{width:100%;height:115px;margin-top:15px}.bot-stats{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:23px 0}.bot-stats b{font-size:22px;font-weight:400;color:#cfb47e}.bot-stats small{display:block;font-size:9px;color:#8a857b;margin-top:3px}.legend-app .mobile-feedback{color:#8f877b}@keyframes wheel{to{transform:rotate(360deg)}}@media(prefers-reduced-motion:reduce){.campaign-wheel{animation:none}.bot-toggle>span{transition:none}}

.shell-content{padding:15px 21px}.shell-content h5{margin:10px 0}.shell-rewards article{padding:11px;margin-top:10px}.shell-rewards article>span{height:70px}.shell-total{padding:14px 0}.shell-total strong{font-size:31px}.period-tabs{margin:14px 0}.fuel-row{padding:13px 0}.shell-help{margin-top:16px;padding:12px}.shell-app .mobile-feedback{font-size:8px;margin-top:10px}.legend-content{padding:18px 22px}.bot-title{margin-bottom:16px}.legend-app h5{margin:12px 0;font-size:29px}.setup-steps{margin-top:17px}.setup-steps>div{padding:15px 0}.legend-callout{margin:16px 0;padding:13px}.legend-callout p{font-size:10px}.exchange{margin:17px 0;padding:12px}.bot-fields label{padding:9px 0}.bot-chart{margin-top:16px;padding:13px}.bot-chart svg{height:95px;margin-top:10px}.bot-stats{margin:17px 0;gap:15px}.bot-stats b{font-size:20px}.legend-app .mobile-feedback{font-size:8px;margin-top:10px}
.shell-app .mobile-feedback{line-height:1.25;margin-top:5px}
</style>
<script>
class MobilePortfolioDemo extends HTMLElement{abort?:AbortController;connectedCallback(){this.abort=new AbortController();this.addEventListener('click',event=>{const button=(event.target as Element).closest<HTMLButtonElement>('button');if(!button)return;const feedback=this.querySelector('.mobile-feedback');if(button.dataset.localMessage&&feedback)feedback.textContent=button.dataset.localMessage;if(button.hasAttribute('data-period')){button.parentElement?.querySelectorAll('button').forEach(item=>item.setAttribute('aria-pressed',String(item===button)));if(feedback)feedback.textContent=`${button.textContent}: filtro seleccionado en la demostración.`;}if(button.hasAttribute('data-bot-toggle')){const on=button.getAttribute('aria-pressed')!=='true';button.setAttribute('aria-pressed',String(on));this.querySelector('[data-bot-status]')!.textContent=on?'Activo (demo)':'Pausado';if(feedback)feedback.textContent='Estado simulado; no se inicia ninguna operación.';}},{signal:this.abort.signal});}disconnectedCallback(){this.abort?.abort();}}
if(!customElements.get('mobile-portfolio-demo'))customElements.define('mobile-portfolio-demo',MobilePortfolioDemo);
</script>
