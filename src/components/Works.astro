---
import rawProjects from '../data/behance-projects.json';

/** Add `internalPath: '/trabajos/nombre'` to migrate any item to an internal case study. */
type WorkProject = { id: string; title: string; url: string; thumbnail: string; internalPath?: string };
const projects = rawProjects as WorkProject[];
---

<section id="trabajos" class="works" aria-labelledby="works-title">
  <works-carousel>
    <div class="works-heading works-inner"><h2 id="works-title">Trabajos</h2></div>

    <div class="works-stage" data-stage>
      <p id="works-help" class="works-sr-only">En escritorio, desplazate verticalmente para recorrer los proyectos en horizontal. También podés arrastrar, usar las flechas o las teclas Inicio y Fin. En pantallas pequeñas los proyectos se muestran uno debajo de otro.</p>
      <div class="works-utility" aria-hidden="true">
        <span class="works-counter" data-counter>01 / {String(projects.length).padStart(2, '0')}</span>
        <span class="works-progress"><span data-progress></span></span>
      </div>
      <div class="works-controls" data-controls hidden>
        <button type="button" data-previous aria-label="Ver proyecto anterior" aria-controls="works-track" disabled><span aria-hidden="true">←</span></button>
        <button type="button" data-next aria-label="Ver proyecto siguiente" aria-controls="works-track"><span aria-hidden="true">→</span></button>
      </div>
      <div id="works-track" class="works-track" data-track tabindex="0" role="region" aria-label="Proyectos destacados" aria-describedby="works-help">
        <ul class="works-list">
          {projects.map((project) => {
            const href = project.internalPath ?? project.url;
            const isExternal = !project.internalPath;
            const destination = isExternal ? 'ver en Behance (abre en otra pestaña)' : 'ver proyecto';
            return <li class="works-item">
              <a class="works-project" href={href} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener noreferrer' : undefined} draggable="false" aria-label={`${project.title} — ${destination}`}>
                <img src={project.thumbnail} alt={`Portada de ${project.title}`} width="1400" height="1095" loading="eager" decoding="async" draggable="false" />
                <span class="works-caption"><span class="works-caption-label">Proyecto</span><span class="works-caption-title">{project.title}</span><span class="works-external" aria-hidden="true">↗</span></span>
              </a>
            </li>;
          })}
        </ul>
      </div>
    </div>
    <div class="works-footer works-inner"><a href="https://www.behance.net/emilgonzalez" target="_blank" rel="noopener noreferrer">Ver todos los trabajos en Behance <span aria-hidden="true">↗</span></a></div>
  </works-carousel>
</section>

<style>
  .works { background: #111; scroll-margin-top: 2rem; }
  works-carousel { display: block; }
  .works-inner { width: 100%; max-width: 1344px; margin-inline: auto; padding-inline: 24px; }
  .works-heading { padding-block: 4rem 1.5rem; background: #fafafa; }
  .works-heading h2 { margin: 0; font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 700; line-height: 1.1; letter-spacing: -.04em; color: #111; }
  .works-stage { position: relative; background: #111; }
  .works-track { width: 100%; overflow: hidden; }
  .works-list { display: flex; margin: 0; padding: 0; list-style: none; will-change: transform; }
  .works-item { flex: 0 0 100%; min-width: 0; }
  .works-project { position: relative; display: block; min-height: 28rem; overflow: hidden; background: #202020; }
  .works-project img { display: block; width: 100%; height: 100%; min-height: 28rem; object-fit: cover; transition: transform 500ms cubic-bezier(.2, .8, .2, 1); }
  .works-project::after { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 42%, rgb(0 0 0 / .62)); content: ''; pointer-events: none; }
  .works-caption { position: absolute; z-index: 1; inset: auto 24px 24px; display: grid; gap: 4px; color: #fff; }
  .works-caption-label { font-size: 10px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; opacity: .75; }
  .works-caption-title { max-width: 32ch; font-size: clamp(1.35rem, 4vw, 2.4rem); font-weight: 600; line-height: 1.05; letter-spacing: -.035em; }
  .works-external { position: absolute; right: 0; bottom: 0; font-size: 24px; line-height: 1; }
  .works-project:hover img { transform: scale(1.035); }
  .works-project:focus-visible { z-index: 2; outline: 3px solid #e63946; outline-offset: -3px; }
  .works-utility, .works-controls { display: none; }
  .works-footer { display: flex; justify-content: flex-start; padding-block: 2.75rem; background: #fafafa; }
  .works-footer a { display: inline-flex; align-items: center; gap: 12px; color: #111; font-size: 13px; font-weight: 500; line-height: 1.5; text-decoration: underline; text-decoration-color: #bdbdbd; text-underline-offset: 5px; }
  .works-footer a:hover { color: #e63946; text-decoration-color: currentColor; }
  .works-footer a:focus-visible, .works-controls button:focus-visible { outline: 2px solid #e63946; outline-offset: 4px; }
  .works-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (max-width: 1023px) {
    .works { background: #fafafa; }
    .works-stage { background: #fafafa; }
    .works-track { overflow: visible; }
    .works-list { display: grid; gap: 2.75rem; padding-inline: 24px; }
    .works-project { min-height: 0; overflow: visible; background: transparent; }
    .works-project img { min-height: 0; aspect-ratio: 5 / 4; object-fit: cover; }
    .works-project::after { display: none; }
    .works-caption { position: relative; inset: auto; padding-top: .9rem; color: #111; }
    .works-external { top: .9rem; right: 0; bottom: auto; }
  }
  @media (min-width: 640px) { .works-inner { padding-inline: 32px; } }
  @media (min-width: 1024px) {
    .works { min-height: 100svh; height: calc(100svh + var(--works-scroll-distance, 0px)); }
    works-carousel { height: 100%; }
    .works-heading, .works-footer { display: none; }
    .works-stage { position: sticky; top: 0; height: 100svh; overflow: hidden; }
    .works-track, .works-list, .works-item, .works-project, .works-project img { height: 100%; min-height: 0; }
    .works-track { height: 100%; }
    .works-list { transform: translate3d(var(--works-translate, 0px), 0, 0); }
    .works-item { flex-basis: 100vw; }
    .works-project::after { background: linear-gradient(180deg, transparent 48%, rgb(0 0 0 / .68)); }
    .works-caption { inset: auto clamp(32px, 7vw, 112px) clamp(32px, 7vh, 72px); max-width: min(54rem, 70vw); }
    .works-caption-label { font-size: 11px; }
    .works-caption-title { font-size: clamp(2rem, 4.6vw, 5.2rem); }
    .works-external { right: auto; left: calc(100% + 28px); bottom: .05em; font-size: 32px; }
    .works-utility { position: absolute; z-index: 2; top: 34px; left: clamp(32px, 7vw, 112px); display: flex; align-items: center; gap: 16px; color: #fff; font-size: 11px; font-weight: 600; letter-spacing: .12em; }
    .works-progress { display: block; width: 64px; height: 1px; overflow: hidden; background: rgb(255 255 255 / .35); }
    .works-progress span { display: block; width: 100%; height: 100%; transform: scaleX(var(--works-progress, .111)); transform-origin: left center; background: #fff; }
    .works-controls { position: absolute; z-index: 2; top: 24px; right: clamp(32px, 7vw, 112px); display: flex; gap: 8px; }
    .works-controls[hidden] { display: none; }
    .works-controls button { display: grid; place-items: center; width: 42px; height: 42px; padding: 0; border: 1px solid rgb(255 255 255 / .45); border-radius: 50%; background: transparent; color: #fff; font-size: 20px; cursor: pointer; transition: background-color 160ms, color 160ms, border-color 160ms; }
    .works-controls button:hover:not(:disabled) { border-color: #fff; background: #fff; color: #111; }
    .works-controls button:disabled { opacity: .35; cursor: default; }
    .works-track[data-drag-ready], .works-track[data-drag-ready] .works-project { cursor: grab; user-select: none; -webkit-user-select: none; }
    .works-track.is-dragging, .works-track.is-dragging .works-project { cursor: grabbing; }
    .works-track:focus-visible { outline: 2px solid #e63946; outline-offset: -4px; }
  }
  @media (prefers-reduced-motion: reduce) { .works-project img, .works-controls button { transition: none; } }
</style>

<script>
  class WorksCarousel extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      if (this.cleanup) return;
      const section = this.closest<HTMLElement>('.works');
      const track = this.querySelector<HTMLElement>('[data-track]');
      const list = this.querySelector<HTMLElement>('.works-list');
      const previous = this.querySelector<HTMLButtonElement>('[data-previous]');
      const next = this.querySelector<HTMLButtonElement>('[data-next]');
      const controls = this.querySelector<HTMLElement>('[data-controls]');
      const counter = this.querySelector<HTMLElement>('[data-counter]');
      if (!section || !track || !list || !previous || !next || !controls || !counter) return;
      const events = new AbortController();
      const desktop = window.matchMedia('(min-width: 1024px)');
      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const total = list.children.length;
      let frame = 0;
      let drag: { pointerId: number; startX: number; startScrollY: number; active: boolean } | undefined;
      let suppressClick = false;
      const clamp = (value: number, min = 0, max = 1) => Math.max(min, Math.min(max, value));
      const maxX = () => Math.max(0, list.scrollWidth - track.clientWidth);
      const scrollDistance = () => Math.max(0, section.offsetHeight - window.innerHeight);
      const sectionTop = () => section.getBoundingClientRect().top + window.scrollY;
      const pageProgress = () => { const distance = scrollDistance(); return distance ? clamp((window.scrollY - sectionTop()) / distance) : 0; };
      const setProgress = (value: number) => {
        const safe = clamp(value);
        const index = total > 1 ? Math.round(safe * (total - 1)) : 0;
        section.style.setProperty('--works-translate', `${-safe * maxX()}px`);
        section.style.setProperty('--works-progress', String(total > 1 ? index / (total - 1) : 1));
        counter.textContent = `${String(index + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
        previous.disabled = safe <= .001;
        next.disabled = safe >= .999;
      };
      const sync = () => { frame = 0; if (desktop.matches) setProgress(pageProgress()); };
      const queueSync = () => { if (!frame) frame = requestAnimationFrame(sync); };
      const goTo = (index: number) => {
        if (!desktop.matches || total < 2) return;
        const target = clamp(index, 0, total - 1);
        window.scrollTo({ top: sectionTop() + scrollDistance() * (target / (total - 1)), behavior: motion.matches ? 'auto' : 'smooth' });
      };
      const syncMode = () => {
        controls.hidden = !desktop.matches;
        track.tabIndex = desktop.matches ? 0 : -1;
        if (desktop.matches) { track.dataset.dragReady = ''; section.style.setProperty('--works-scroll-distance', `${maxX()}px`); queueSync(); }
        else { delete track.dataset.dragReady; section.style.removeProperty('--works-scroll-distance'); section.style.removeProperty('--works-translate'); section.style.removeProperty('--works-progress'); }
      };
      const finishDrag = (event?: PointerEvent, snap = true) => {
        if (!drag || (event && event.pointerId !== drag.pointerId)) return;
        const ended = drag; drag = undefined; track.classList.remove('is-dragging');
        if (track.hasPointerCapture(ended.pointerId)) track.releasePointerCapture(ended.pointerId);
        if (ended.active && snap) goTo(Math.round(pageProgress() * (total - 1)));
      };
      track.addEventListener('pointerdown', (event) => {
        suppressClick = false;
        if (!desktop.matches || event.pointerType !== 'mouse' || event.button !== 0 || !event.isPrimary || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey || maxX() === 0) return;
        drag = { pointerId: event.pointerId, startX: event.clientX, startScrollY: window.scrollY, active: false };
      }, { signal: events.signal });
      window.addEventListener('pointermove', (event) => {
        if (!drag || event.pointerId !== drag.pointerId) return;
        if (!(event.buttons & 1)) { finishDrag(event); return; }
        const distance = event.clientX - drag.startX;
        if (!drag.active) { if (Math.abs(distance) < 6) return; drag.active = true; suppressClick = true; track.classList.add('is-dragging'); track.setPointerCapture(event.pointerId); }
        event.preventDefault();
        window.scrollTo({ top: drag.startScrollY - (distance / maxX()) * scrollDistance(), behavior: 'auto' });
      }, { signal: events.signal });
      window.addEventListener('pointerup', (event) => finishDrag(event), { signal: events.signal });
      window.addEventListener('pointercancel', (event) => finishDrag(event), { signal: events.signal });
      track.addEventListener('lostpointercapture', (event) => finishDrag(event), { signal: events.signal });
      window.addEventListener('blur', () => finishDrag(), { signal: events.signal });
      track.addEventListener('click', (event) => { if (suppressClick && event.detail !== 0) { event.preventDefault(); event.stopPropagation(); suppressClick = false; } }, { capture: true, signal: events.signal });
      previous.addEventListener('click', () => goTo(Math.round(pageProgress() * (total - 1)) - 1), { signal: events.signal });
      next.addEventListener('click', () => goTo(Math.round(pageProgress() * (total - 1)) + 1), { signal: events.signal });
      track.addEventListener('keydown', (event) => {
        if (event.target !== track || event.altKey || event.ctrlKey || event.metaKey) return;
        const current = Math.round(pageProgress() * (total - 1));
        if (event.key === 'ArrowLeft') goTo(current - 1); else if (event.key === 'ArrowRight') goTo(current + 1); else if (event.key === 'Home') goTo(0); else if (event.key === 'End') goTo(total - 1); else return;
        event.preventDefault();
      }, { signal: events.signal });
      window.addEventListener('scroll', queueSync, { passive: true, signal: events.signal });
      const resize = new ResizeObserver(syncMode); resize.observe(track); syncMode();
      desktop.addEventListener('change', syncMode, { signal: events.signal });
      this.cleanup = () => { events.abort(); finishDrag(undefined, false); resize.disconnect(); cancelAnimationFrame(frame); delete track.dataset.dragReady; };
    }
    disconnectedCallback() { this.cleanup?.(); this.cleanup = undefined; }
  }
  if (!customElements.get('works-carousel')) customElements.define('works-carousel', WorksCarousel);
</script>
