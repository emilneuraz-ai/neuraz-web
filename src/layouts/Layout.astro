---
// src/layouts/Layout.astro
import '../styles/global.css';
import PageLoader from '../components/PageLoader.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Neuraz - Tecnología con propósito. Diseñamos sistemas inteligentes para crear, documentar y automatizar tu negocio." } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="inteligencia artificial, automatización, IA, chatbots, CRM, gamificación, fidelización, documentación inteligente, Argentina" />
    <meta name="author" content="Neuraz" />
    <meta name="robots" content="index, follow" />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Neuraz" />
    <meta property="og:locale" content="es_AR" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    
    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />
    
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/images/isotipo.svg" />
    
    <!-- MCP for AI Agents -->
    <link rel="alternate" type="text/markdown" href="/mcp.md" title="MCP - Model Context Protocol" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body class="bg-[#fafafa] text-black font-sans antialiased">
    <PageLoader />
    <slot />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  
  body {
    font-feature-settings: "cv02", "cv03", "cv04", "cv11";
  }
  
  ::selection {
    background-color: rgba(14, 165, 233, 0.3);
    color: white;
  }

  @media (max-width: 767px) and (prefers-reduced-motion: no-preference) {
    html[data-section-motion="true"] main > section > :not(.section-atmosphere) {
      opacity: calc(0.12 + var(--section-visibility, 1) * 0.88);
      transform: translate3d(0, calc((1 - var(--section-visibility, 1)) * 16px), 0);
      will-change: opacity, transform;
    }
  }
</style>

<script>
  const motionSections = Array.from(document.querySelectorAll<HTMLElement>('main > section'));
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  let sectionMotionFrame = 0;

  function updateSectionMotion() {
    sectionMotionFrame = 0;
    const viewportHeight = innerHeight;
    motionSections.forEach(section => {
      const rect = section.getBoundingClientRect();
      const visiblePixels = Math.max(0, Math.min(rect.bottom, viewportHeight) - Math.max(rect.top, 0));
      const ratio = Math.min(1, visiblePixels / Math.min(viewportHeight, Math.max(1, rect.height)));
      const eased = ratio * ratio * (3 - 2 * ratio);
      section.style.setProperty('--section-visibility', reducedMotion.matches ? '1' : eased.toFixed(3));
    });
  }

  function scheduleSectionMotion() {
    if (!sectionMotionFrame) sectionMotionFrame = requestAnimationFrame(updateSectionMotion);
  }

  document.documentElement.dataset.sectionMotion = 'true';
  updateSectionMotion();
  window.addEventListener('scroll', scheduleSectionMotion, { passive: true });
  window.addEventListener('resize', scheduleSectionMotion, { passive: true });
  reducedMotion.addEventListener('change', scheduleSectionMotion);
</script>
